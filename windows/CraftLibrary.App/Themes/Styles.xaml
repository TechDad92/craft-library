<!--
    Shared looks for the whole app. Colours come from ThemeService (B.* brushes), so every style follows her settings.
    Buttons are always the "stitched" style: a dashed line just inside the edge. Plain see-through buttons
    (rows in lists, links) show no stitching until they become the current one.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:CraftLibrary.App.Controls">

    <c:VisibleIf x:Key="Vis" />
    <c:HexBrush x:Key="Hex" />
    <c:Not x:Key="Not" />
    <c:SideIf x:Key="SideIf" />
    <c:ThumbFill x:Key="ThumbFill" />

    <!-- Keyboard focus: a clear ring in the accent colour. -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="12" RadiusY="12" Stroke="{DynamicResource B.accent-line}" StrokeThickness="3" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Buttons ===================== -->
    <ControlTemplate x:Key="ButtonTemplate" TargetType="ButtonBase">
        <Grid SnapsToDevicePixels="True">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{Binding (c:Ui.Radius), RelativeSource={RelativeSource TemplatedParent}}" />
            <Border x:Name="Hover" Background="#14000000" Opacity="0" CornerRadius="{Binding (c:Ui.Radius), RelativeSource={RelativeSource TemplatedParent}}" />
            <Rectangle x:Name="Stitch" Margin="4.25" RadiusX="6" RadiusY="6" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"
                       StrokeDashArray="2 1.6" Opacity="0.6" IsHitTestVisible="False"
                       Visibility="{Binding (c:Ui.Stitched), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Vis}}" />
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="False" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Hover" Property="Opacity" Value="0.55" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Hover" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="BtnBase" TargetType="ButtonBase">
        <Setter Property="Template" Value="{StaticResource ButtonTemplate}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ToolTipService.IsEnabled" Value="{DynamicResource TipsOn}" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="500" />
    </Style>

    <!-- Main action, filled with the accent colour. -->
    <Style x:Key="Btn.Primary" TargetType="ButtonBase" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{DynamicResource B.accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource B.accent-line}" />
        <Setter Property="Foreground" Value="{DynamicResource B.on-accent}" />
    </Style>

    <!-- Everyday button on a white panel. -->
    <Style x:Key="Btn.Plain" TargetType="ButtonBase" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{DynamicResource B.panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource B.ctl}" />
        <Setter Property="Foreground" Value="{DynamicResource B.text}" />
    </Style>

    <!-- Warning action (removing files). -->
    <Style x:Key="Btn.Danger" TargetType="ButtonBase" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{DynamicResource B.warn-bg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource B.warn-line}" />
        <Setter Property="Foreground" Value="{DynamicResource B.warn-ink}" />
    </Style>

    <!-- See-through button: no stitching (icons, close buttons). -->
    <Style x:Key="Btn.Ghost" TargetType="ButtonBase" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource B.text}" />
        <Setter Property="c:Ui.Stitched" Value="False" />
        <Setter Property="c:Ui.Radius" Value="8" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="Btn.Icon" TargetType="ButtonBase" BasedOn="{StaticResource Btn.Ghost}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Minimise / maximise / close, in the top-right corner of the banner. Square, see-through, no stitching. -->
    <Style x:Key="Btn.Caption" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="40" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="c:Ui.Radius" Value="0" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource B.text}" />
        <Setter Property="ToolTipService.IsEnabled" Value="True" />
    </Style>
    <Style x:Key="Btn.CaptionClose" TargetType="Button" BasedOn="{StaticResource Btn.Caption}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#C42B1C" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Words in the accent colour, like a link. -->
    <Style x:Key="Btn.Link" TargetType="ButtonBase" BasedOn="{StaticResource Btn.Ghost}">
        <Setter Property="Foreground" Value="{DynamicResource B.accent-text}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="6,0" />
    </Style>

    <!-- A row in a list (folders, menu items). Stitched and coloured when it is the current one. -->
    <Style x:Key="Btn.Row" TargetType="ButtonBase" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource B.text}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="MinHeight" Value="{DynamicResource SideRowHeight}" />
        <Setter Property="c:Ui.Stitched" Value="False" />
        <Style.Triggers>
            <Trigger Property="c:Ui.Active" Value="True">
                <Setter Property="Background" Value="{DynamicResource B.accent-soft}" />
                <Setter Property="BorderBrush" Value="{DynamicResource B.accent-line}" />
                <Setter Property="Foreground" Value="{DynamicResource B.accent-strong}" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="c:Ui.Stitched" Value="True" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- One choice in a set (Light / Dark, Small / Medium / Large…). -->
    <Style x:Key="Btn.Seg" TargetType="ButtonBase" BasedOn="{StaticResource Btn.Plain}">
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="FontWeight" Value="Medium" />
        <Style.Triggers>
            <Trigger Property="c:Ui.Active" Value="True">
                <Setter Property="Background" Value="{DynamicResource B.accent}" />
                <Setter Property="BorderBrush" Value="{DynamicResource B.accent-line}" />
                <Setter Property="Foreground" Value="{DynamicResource B.on-accent}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Toolbar buttons (Back, Undo…): stitched like every button, a little more compact. -->
    <Style x:Key="Btn.Tool" TargetType="ButtonBase" BasedOn="{StaticResource Btn.Plain}">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="ToolTipService.IsEnabled" Value="True" />
    </Style>

    <!-- Toolbar choices (Grid / List). -->
    <Style x:Key="Btn.ToolSeg" TargetType="ButtonBase" BasedOn="{StaticResource Btn.Seg}">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="ToolTipService.IsEnabled" Value="True" />
    </Style>

    <!-- Round colour swatch (accent colours, folder labels). Content is not shown; Background is the colour. -->
    <Style x:Key="Btn.Swatch" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="Ring" Stroke="{DynamicResource B.text}" StrokeThickness="2" Visibility="Collapsed" />
                        <Ellipse Margin="5" Fill="{TemplateBinding Background}" Stroke="{DynamicResource B.border}" StrokeThickness="1" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="c:Ui.Active" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Text boxes ===================== -->
    <Style x:Key="Field" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource B.field}" />
        <Setter Property="Foreground" Value="{DynamicResource B.text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource B.ctl}" />
        <Setter Property="CaretBrush" Value="{DynamicResource B.text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource B.accent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{Binding (c:Ui.Radius), RelativeSource={RelativeSource TemplatedParent}}" SnapsToDevicePixels="True">
                        <Grid>
                            <TextBlock x:Name="Hint" Text="{TemplateBinding c:Ui.Placeholder}" Foreground="{DynamicResource B.muted}" Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Padding="2,0,0,0" IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis" />
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource B.accent-line}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Field.Multi" TargetType="TextBox" BasedOn="{StaticResource Field}">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <!-- ===================== Check boxes ===================== -->
    <Style x:Key="Check" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource B.text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="22" Height="22" CornerRadius="6" BorderThickness="2" BorderBrush="{DynamicResource B.ctl}" Background="{DynamicResource B.panel}" VerticalAlignment="Top" Margin="0,1,12,0">
                            <c:Icon x:Name="Tick" Glyph="{StaticResource Icon.Check}" Size="16" Thickness="3" Foreground="{DynamicResource B.on-accent}" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource B.accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource B.accent-line}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Scroll bars, in the app's own colours ===================== -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="T" CornerRadius="5" Margin="3" Background="{DynamicResource B.ctl}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="Background" Value="{DynamicResource B.muted}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="T" Property="Background" Value="{DynamicResource B.muted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PageRepeat" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="14" />
        <Setter Property="MinWidth" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource PageRepeat}" Command="ScrollBar.PageUpCommand" />
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource PageRepeat}" Command="ScrollBar.PageDownCommand" />
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollThumb}" MinHeight="48" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="14" />
                <Setter Property="MinHeight" Value="14" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource PageRepeat}" Command="ScrollBar.PageLeftCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource PageRepeat}" Command="ScrollBar.PageRightCommand" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" MinWidth="48" />
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>


    <!-- ===================== Text ===================== -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource B.muted}" />
        <Setter Property="Margin" Value="12,16,12,8" />
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource B.muted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ===================== Cards and pop-ups ===================== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource B.panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource B.border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>


    <!-- Pop-up menus. The shadow is drawn by ShadowBorder (never an Effect: effects blur the text when the app is scaled). -->
    <Style x:Key="PopupCard" TargetType="c:ShadowBorder" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="8" />
        <Setter Property="Margin" Value="12,6,12,24" />
        <Setter Property="TextElement.FontFamily" Value="{DynamicResource F.popups}" />
    </Style>

    <!-- Little dark label on thumbnails ("JPG"). -->
    <Style x:Key="TypeBadge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource B.badge}" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="7,1" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="8" />
        <Setter Property="TextElement.Foreground" Value="White" />
        <Setter Property="TextElement.FontSize" Value="11" />
        <Setter Property="TextElement.FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="WarnBadge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource B.warn-bg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource B.warn-line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource B.warn-ink}" />
        <Setter Property="TextElement.FontSize" Value="12" />
        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource B.toast}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" MaxWidth="320">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Drop-down lists (Settings › Open files with) ===================== -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource B.text}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.accent-soft}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource B.text}" />
        <Setter Property="Background" Value="{DynamicResource B.field}" />
        <Setter Property="BorderBrush" Value="{DynamicResource B.ctl}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1" CornerRadius="10">
                                        <c:Icon Glyph="{StaticResource Icon.ChevronDown}" Size="16" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    </Border>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="12,0,36,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <c:ShadowBorder Style="{StaticResource Card}" Margin="0,4,0,16" Padding="6" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </c:ShadowBorder>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A list that draws only what is on screen (fast with thousands of files), with smooth scrolling. -->
    <Style x:Key="FastList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource B.text}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="VirtualizingPanel.CacheLengthUnit" Value="Page" />
        <Setter Property="VirtualizingPanel.CacheLength" Value="1,1" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
