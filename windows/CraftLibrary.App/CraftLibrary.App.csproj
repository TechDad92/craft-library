<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 version 1809 or later. The Windows 10 SDK part gives access to the built-in PDF reader. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Lets this be built on Linux or macOS too (it still only runs on Windows). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CraftLibrary</AssemblyName>
    <RootNamespace>CraftLibrary.App</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Craft Library</Product>
    <AssemblyTitle>Craft Library</AssemblyTitle>
    <Company>Craft Library</Company>
    <Copyright>Craft Library</Copyright>
    <!-- The one place the version number lives. The installer reads it from the built program. -->
    <Version>0.3.4</Version>
    <!-- One self-contained file: nothing else needs installing on the computer. -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
    <!-- The screen code sometimes changes a value quietly and redraws everything at once afterwards. -->
    <NoWarn>$(NoWarn);MVVMTK0034</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CraftLibrary.Core\CraftLibrary.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Fonts\*.ttf" />
    <Resource Include="icon.png" />
  </ItemGroup>

</Project>
