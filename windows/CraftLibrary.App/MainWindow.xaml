<Window x:Class="CraftLibrary.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:CraftLibrary.App.Controls"
        xmlns:v="clr-namespace:CraftLibrary.App.Views"
        Title="Craft Library" Width="1400" Height="900" MinWidth="900" MinHeight="600"
        Icon="pack://application:,,,/icon.png"
        Background="{DynamicResource B.bg}" Foreground="{DynamicResource B.text}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="CenterScreen">
    <!-- No separate Windows title bar: the banner is the title bar (drag it to move the window, double-click to maximise).
         The bottom glass line keeps Windows' drop shadow. The caption height is set from the banner in MainWindow.xaml.cs. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="76" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- A slim tab at the edge of the window that brings a hidden panel back (like the one under the top bar for the toolbar).
             Tag holds the rounded corners, BorderThickness leaves the edge side open. -->
        <Style x:Key="EdgeTab" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="ToolTipService.IsEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Tab" Background="{DynamicResource B.chrome}" BorderBrush="{DynamicResource B.divider}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="{DynamicResource B.accent-soft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid TextBlock.LineHeight="{DynamicResource LineHeight}">
        <!-- Background pattern (Settings › Background), behind everything. -->
        <Rectangle Fill="{DynamicResource B.texture}" IsHitTestVisible="False" />

        <Grid x:Name="Root">
            <Grid.LayoutTransform>
                <ScaleTransform ScaleX="{DynamicResource Zoom}" ScaleY="{DynamicResource Zoom}" />
            </Grid.LayoutTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============ Top banner ============ -->
            <Border x:Name="Banner" Background="{DynamicResource B.chrome}" BorderBrush="{DynamicResource B.divider}" BorderThickness="0,0,0,3" Padding="24,12,24,12" TextElement.FontFamily="{DynamicResource F.banner}">
                <!-- Left: logo and title. Middle: Menu and search, centred on the window. Right: occasional buttons, then the window buttons.
                     The two side columns are equal, which keeps the middle exactly centred; MainWindow.xaml.cs narrows the
                     search box when the window is too small for everything. Empty parts of the banner drag the window. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="BannerLeft" Grid.Column="0" HorizontalAlignment="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="48" Height="48">
                            <Border CornerRadius="12" Background="{DynamicResource B.accent}" BorderBrush="{DynamicResource B.accent-line}" BorderThickness="1" />
                            <Rectangle Margin="4.25" RadiusX="8" RadiusY="8" Stroke="{DynamicResource B.on-accent}" StrokeThickness="1.5" StrokeDashArray="2 1.6" Opacity="0.6" />
                            <c:Icon Glyph="{StaticResource Icon.Logo}" Size="26" Foreground="{DynamicResource B.on-accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="Craft Library" FontSize="21" FontWeight="Bold" Margin="12,0,24,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Middle: Menu, then search -->
                    <StackPanel x:Name="BannerCenter" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True"
                                IsEnabled="{Binding GuideOpen, Converter={StaticResource Not}}">
                        <Grid x:Name="SearchArea" Width="480" VerticalAlignment="Center" Visibility="{Binding ShowSearch, Converter={StaticResource Vis}}">
                            <TextBox x:Name="SearchBox" Style="{StaticResource Field}" Background="{DynamicResource B.panel}" BorderBrush="Transparent" Padding="38,8,12,8"
                                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="Search all files by name" AutomationProperties.Name="Search all files by name" />
                            <c:Icon Glyph="{StaticResource Icon.Search}" Size="18" Foreground="{DynamicResource B.muted}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,0" />
                        </Grid>
                    </StackPanel>

                    <!-- Right: minimise / maximise / close (the top bar stays simple: logo, name, search, window buttons) -->
                    <StackPanel x:Name="BannerRight" Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="14,-12,-24,0" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Button Style="{StaticResource Btn.Caption}" Click="OnMinimise" ToolTip="Minimise" AutomationProperties.Name="Minimise">
                                <c:Icon Glyph="{StaticResource Icon.WinMin}" Size="20" Thickness="1.2" />
                            </Button>
                            <Button x:Name="MaxButton" Style="{StaticResource Btn.Caption}" Click="OnMaximise" ToolTip="Maximise" AutomationProperties.Name="Maximise">
                                <c:Icon x:Name="MaxIcon" Glyph="{StaticResource Icon.WinMax}" Size="20" Thickness="1.2" />
                            </Button>
                            <Button Style="{StaticResource Btn.CaptionClose}" Click="OnCloseWindow" ToolTip="Close" AutomationProperties.Name="Close">
                                <c:Icon Glyph="{StaticResource Icon.WinClose}" Size="20" Thickness="1.2" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ Toolbar: everything that used to be in the Menu, plus Back / Forward, Undo / Redo and view controls.
                 Hidden with "Hide toolbar" in the banner or Settings › Layout. On a narrow window the right-hand group
                 moves onto a second line (MainWindow.xaml.cs, FitToolbar) instead of being cut off. ============ -->
            <Border Grid.Row="1" Background="{DynamicResource B.panel}" BorderBrush="{DynamicResource B.border}" BorderThickness="0,0,0,1" Padding="16,8"
                    TextElement.FontFamily="{DynamicResource F.banner}" Visibility="{Binding ToolbarVisible, Converter={StaticResource Vis}}">
                <Grid x:Name="Toolbar">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Left: going places and undoing, then Duplicates and History -->
                    <StackPanel x:Name="ToolLeft" Orientation="Horizontal" HorizontalAlignment="Left" Visibility="{Binding ShowNavTools, Converter={StaticResource Vis}}">
                        <Button Style="{StaticResource Btn.Tool}" Command="{Binding GoBack}" IsEnabled="{Binding CanGoBack}" ToolTip="{Binding BackHint}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Back">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Glyph="{StaticResource Icon.Back}" Size="18" Visibility="{DynamicResource V.btnIcon}" />
                                <TextBlock Text="Back" Margin="8,0,0,0" Visibility="{DynamicResource V.btnWord}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Btn.Tool}" Command="{Binding GoForward}" IsEnabled="{Binding CanGoForward}" ToolTip="{Binding ForwardHint}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Forward">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Glyph="{StaticResource Icon.Forward}" Size="18" Visibility="{DynamicResource V.btnIcon}" />
                                <TextBlock Text="Forward" Margin="8,0,0,0" Visibility="{DynamicResource V.btnWord}" />
                            </StackPanel>
                        </Button>
                        <Rectangle Width="1" Height="26" Fill="{DynamicResource B.border}" Margin="6,0,14,0" Visibility="{Binding FeatUndo, Converter={StaticResource Vis}}" />
                        <Button Style="{StaticResource Btn.Tool}" Command="{Binding Undo}" IsEnabled="{Binding CanUndo}" ToolTip="{Binding UndoHint}" ToolTipService.ShowOnDisabled="True" Visibility="{Binding FeatUndo, Converter={StaticResource Vis}}" AutomationProperties.Name="Undo">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Glyph="{StaticResource Icon.Undo}" Size="18" Visibility="{DynamicResource V.btnIcon}" />
                                <TextBlock Text="Undo" Margin="8,0,0,0" Visibility="{DynamicResource V.btnWord}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Btn.Tool}" Command="{Binding Redo}" IsEnabled="{Binding CanRedo}" ToolTip="{Binding RedoHint}" ToolTipService.ShowOnDisabled="True" Visibility="{Binding FeatUndo, Converter={StaticResource Vis}}" AutomationProperties.Name="Redo">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Glyph="{StaticResource Icon.Redo}" Size="18" Visibility="{DynamicResource V.btnIcon}" />
                                <TextBlock Text="Redo" Margin="8,0,0,0" Visibility="{DynamicResource V.btnWord}" />
                            </StackPanel>
                        </Button>
                        <Rectangle Width="1" Height="26" Fill="{DynamicResource B.border}" Margin="6,0,14,0" />
                        <Button Style="{StaticResource Btn.ToolSeg}" Command="{Binding GoDupes}" c:Ui.Active="{Binding IsDupes}" ToolTip="Files saved more than once" Visibility="{Binding FeatDupes, Converter={StaticResource Vis}}" AutomationProperties.Name="Duplicates">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Glyph="{StaticResource Icon.Copy}" Size="18" Visibility="{DynamicResource V.btnIcon}" />
                                <TextBlock Text="Duplicates" Margin="8,0,0,0" Visibility="{DynamicResource V.btnWord}" />
                                <Border Style="{StaticResource WarnBadge}" Margin="8,0,0,0" Padding="7,0" Visibility="{Binding HasDupGroups, Converter={StaticResource Vis}}">
                                    <TextBlock Text="{Binding DupGroupCount}" />
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Btn.Tool}" Command="{Binding OpenHistory}" ToolTip="Everything you’ve done today, with Undo" Visibility="{Binding FeatHistory, Converter={StaticResource Vis}}" AutomationProperties.Name="History">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Glyph="{StaticResource Icon.Clock}" Size="18" Visibility="{DynamicResource V.btnIcon}" />
                                <TextBlock Text="History" Margin="8,0,0,0" Visibility="{DynamicResource V.btnWord}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Right: occasional bits, view controls, then Settings -->
                    <StackPanel x:Name="ToolRight" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Border Visibility="{Binding ShowProgressPill, Converter={StaticResource Vis}}" Background="{DynamicResource B.panel}" CornerRadius="999" Padding="14,8" Margin="0,0,10,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Glyph="{StaticResource Icon.Check}" Size="16" Foreground="{DynamicResource B.accent-text}" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding ProgressText}" FontSize="13" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Grid Margin="0,0,10,0" Visibility="{Binding HasHiddenShown, Converter={StaticResource Vis}}">
                            <ToggleButton x:Name="HiddenBtn" Style="{StaticResource Btn.Plain}" IsChecked="{Binding HiddenMenuOpen}" ToolTip="Things you have hidden. Click to bring them back."
                                          IsHitTestVisible="{Binding IsOpen, ElementName=HiddenPopup, Converter={StaticResource Not}}">
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Glyph="{StaticResource Icon.EyeOff}" Size="18" Margin="0,0,8,0" Visibility="{DynamicResource V.btnIcon}" />
                                    <TextBlock Text="Hidden" Visibility="{DynamicResource V.btnWord}" />
                                    <Border Background="{DynamicResource B.subtle}" CornerRadius="999" Padding="7,0" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding HiddenCount}" FontSize="12" />
                                    </Border>
                                </StackPanel>
                            </ToggleButton>
                            <Popup x:Name="HiddenPopup" IsOpen="{Binding HiddenMenuOpen}" StaysOpen="False" PlacementTarget="{Binding ElementName=HiddenBtn}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
                                <c:ShadowBorder Style="{StaticResource PopupCard}" Width="300">
                                    <StackPanel>
                                        <TextBlock Text="HIDDEN FOR NOW" Style="{StaticResource SectionLabel}" Margin="8,4,8,6" />
                                        <ItemsControl ItemsSource="{Binding HiddenFeatures}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="8,2">
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Content="Show" Command="{Binding Show}" />
                                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontSize="14" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Style="{StaticResource Btn.Plain}" Content="Show all" Command="{Binding ShowAllHidden}" Margin="8,8,8,4" />
                                    </StackPanel>
                                </c:ShadowBorder>
                            </Popup>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding ShowViewControls, Converter={StaticResource Vis}}" IsEnabled="{Binding ShowNavTools}">
                            <TextBlock Text="Show as" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource B.muted}" Margin="8,0,8,0" />
                            <Button Style="{StaticResource Btn.ToolSeg}" c:Ui.Active="{Binding ViewIsGrid}" Command="{Binding ShowAsGrid}" ToolTip="Grid of thumbnails" AutomationProperties.Name="Show as grid">
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Glyph="{StaticResource Icon.Grid4}" Size="18" Visibility="{DynamicResource V.btnIcon}" />
                                    <TextBlock Text="Grid" Margin="6,0,0,0" Visibility="{DynamicResource V.btnWord}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Btn.ToolSeg}" c:Ui.Active="{Binding ViewIsList}" Command="{Binding ShowAsList}" ToolTip="List with details" AutomationProperties.Name="Show as list">
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Glyph="{StaticResource Icon.List}" Size="18" Visibility="{DynamicResource V.btnIcon}" />
                                    <TextBlock Text="List" Margin="6,0,0,0" Visibility="{DynamicResource V.btnWord}" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="Order by" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource B.muted}" Margin="14,0,8,0" />
                            <ComboBox ItemsSource="{Binding OrderChoices}" SelectedItem="{Binding OrderChoice}" Width="160" MinHeight="36" FontSize="14" AutomationProperties.Name="Order files by" />
                        </StackPanel>
                        <Rectangle Width="1" Height="26" Fill="{DynamicResource B.border}" Margin="6,0,14,0" />
                        <Button Style="{StaticResource Btn.ToolSeg}" Command="{Binding ToggleSettings}" c:Ui.Active="{Binding SettingsOpen}" ToolTip="Change how the app looks and works" AutomationProperties.Name="Settings">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Glyph="{StaticResource Icon.Sliders}" Size="18" Visibility="{DynamicResource V.btnIcon}" />
                                <TextBlock Text="Settings" Margin="8,0,0,0" Visibility="{DynamicResource V.btnWord}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Btn.Icon}" Width="36" Height="36" Command="{Binding ToggleToolbar}" Foreground="{DynamicResource B.muted}" Margin="4,0,0,0"
                                ToolTip="Hide the toolbar" ToolTipService.IsEnabled="True" AutomationProperties.Name="Hide the toolbar">
                            <c:Icon Glyph="{StaticResource Icon.ChevronDown}" Size="18">
                                <c:Icon.LayoutTransform>
                                    <RotateTransform Angle="180" />
                                </c:Icon.LayoutTransform>
                            </c:Icon>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ Folder list | files | preview ============ -->
            <DockPanel Grid.Row="2" LastChildFill="True">
                <v:SidebarView DockPanel.Dock="{Binding SidebarRight, Converter={StaticResource SideIf}, ConverterParameter='Right|Left'}"
                               Visibility="{Binding ShowSidebar, Converter={StaticResource Vis}}" />
                <!-- Half-way down the folder list's inner edge: hides it, and stays at the window's edge to bring it back -->
                <Button DockPanel.Dock="{Binding SidebarRight, Converter={StaticResource SideIf}, ConverterParameter='Right|Left'}" VerticalAlignment="Center"
                        Width="22" Height="72" Command="{Binding ToggleFolders}" Visibility="{Binding FoldersTab, Converter={StaticResource Vis}}"
                        ToolTip="{Binding FoldersTabHint}" AutomationProperties.Name="{Binding FoldersTabHint}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource EdgeTab}">
                            <Setter Property="Tag" Value="0,12,12,0" />
                            <Setter Property="BorderThickness" Value="0,1.5,1.5,1.5" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SidebarRight}" Value="True">
                                    <Setter Property="Tag" Value="12,0,0,12" />
                                    <Setter Property="BorderThickness" Value="1.5,1.5,0,1.5" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <c:Icon Glyph="{StaticResource Icon.ChevronRight}" Size="16" Foreground="{DynamicResource B.chrome-muted}">
                        <c:Icon.LayoutTransform>
                            <RotateTransform Angle="{Binding FoldersTabAngle}" />
                        </c:Icon.LayoutTransform>
                    </c:Icon>
                </Button>
                <v:PreviewView DockPanel.Dock="{Binding PreviewBottom, Converter={StaticResource SideIf}, ConverterParameter='Bottom|Right'}"
                               Visibility="{Binding ShowPreviewPanel, Converter={StaticResource Vis}}" />
                <!-- On the preview's inner edge (half-way down, or in the middle when it's at the bottom): hides it, and stays at the window's edge to bring it back -->
                <Button DockPanel.Dock="{Binding PreviewBottom, Converter={StaticResource SideIf}, ConverterParameter='Bottom|Right'}"
                        Command="{Binding TogglePreview}" Visibility="{Binding PreviewTab, Converter={StaticResource Vis}}"
                        ToolTip="{Binding PreviewTabHint}" AutomationProperties.Name="{Binding PreviewTabHint}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource EdgeTab}">
                            <Setter Property="Tag" Value="12,0,0,12" />
                            <Setter Property="BorderThickness" Value="1.5,1.5,0,1.5" />
                            <Setter Property="Width" Value="22" />
                            <Setter Property="Height" Value="72" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PreviewBottom}" Value="True">
                                    <Setter Property="Tag" Value="12,12,0,0" />
                                    <Setter Property="BorderThickness" Value="1.5,1.5,1.5,0" />
                                    <Setter Property="Width" Value="72" />
                                    <Setter Property="Height" Value="22" />
                                    <Setter Property="VerticalAlignment" Value="Bottom" />
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <c:Icon Glyph="{StaticResource Icon.ChevronRight}" Size="16" Foreground="{DynamicResource B.chrome-muted}">
                        <c:Icon.LayoutTransform>
                            <RotateTransform Angle="{Binding PreviewTabAngle}" />
                        </c:Icon.LayoutTransform>
                    </c:Icon>
                </Button>
                <Grid>
                    <v:FilesView Visibility="{Binding ShowFiles, Converter={StaticResource Vis}}" />
                    <!-- First visit -->
                    <StackPanel Visibility="{Binding IsSetup, Converter={StaticResource Vis}}" HorizontalAlignment="Center" Margin="24,70,24,0" MaxWidth="480" TextElement.FontFamily="{DynamicResource F.files}">
                        <c:Icon Glyph="{StaticResource Icon.Folder}" Size="64" Thickness="1.6" Foreground="{DynamicResource B.accent-strong}" HorizontalAlignment="Center" />
                        <TextBlock Text="Welcome to Craft Library" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,14,0,10" />
                        <TextBlock FontSize="16" Foreground="{DynamicResource B.muted}" TextWrapping="Wrap" TextAlignment="Center"
                                   Text="Start by choosing your main craft folder. The app only works inside the folders you choose, so nothing else on the computer is touched. You can change how the app looks any time in Settings." />
                    </StackPanel>
                    <v:DuplicatesView Visibility="{Binding IsDupes, Converter={StaticResource Vis}}" />
                    <v:BinView Visibility="{Binding IsBin, Converter={StaticResource Vis}}" />
                </Grid>
            </DockPanel>

            <!-- ============ When the toolbar is hidden: a slim tab hanging under the top bar, in the middle, to pull it back down ============ -->
            <Button Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Top" Panel.ZIndex="5" Cursor="Hand" Command="{Binding ToggleToolbar}"
                    Visibility="{Binding ToolbarVisible, Converter={StaticResource Vis}, ConverterParameter=not}"
                    ToolTip="Show the toolbar" ToolTipService.IsEnabled="True" AutomationProperties.Name="Show the toolbar" FocusVisualStyle="{StaticResource FocusRing}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Tab" Width="64" Height="20" Background="{DynamicResource B.chrome}" BorderBrush="{DynamicResource B.divider}"
                                BorderThickness="1.5,0,1.5,1.5" CornerRadius="0,0,12,12">
                            <c:Icon Glyph="{StaticResource Icon.ChevronDown}" Size="16" Foreground="{DynamicResource B.chrome-muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tab" Property="Height" Value="24" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- ============ Settings panel (slides over from the right) ============ -->
            <!-- Below the banner, so the window buttons stay reachable. -->
            <Grid Grid.Row="1" Grid.RowSpan="2" HorizontalAlignment="Right" Width="440" Visibility="{Binding SettingsOpen, Converter={StaticResource Vis}}">
                <v:SettingsView DataContext="{Binding SettingsVm}" />
            </Grid>

            <!-- ============ First-run setup guide (below the banner, so the window buttons still work) ============ -->
            <Grid Grid.Row="1" Grid.RowSpan="2" Visibility="{Binding GuideOpen, Converter={StaticResource Vis}}">
                <v:SetupGuideView DataContext="{Binding Guide}" />
            </Grid>

            <!-- ============ Pop-up windows ============ -->
            <v:DialogsView Grid.Row="0" Grid.RowSpan="3" WindowChrome.IsHitTestVisibleInChrome="True" />

            <!-- ============ Message at the bottom ============ -->
            <c:ShadowBorder Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="24,0,24,24" MaxWidth="760"
                    Background="{DynamicResource B.toast}" CornerRadius="12" Padding="18,6,6,6"
                    Visibility="{Binding HasToast, Converter={StaticResource Vis}}" TextElement.FontFamily="{DynamicResource F.popups}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Foreground="White" Command="{Binding DismissToast}" AutomationProperties.Name="Close message">
                        <c:Icon Glyph="{StaticResource Icon.Close}" Size="18" />
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Plain}" Background="{DynamicResource B.toast-btn}" BorderBrush="{DynamicResource B.toast-btn}" Foreground="White" Margin="12,0,4,0"
                            Command="{Binding Undo}" Visibility="{Binding ToastUndo, Converter={StaticResource Vis}}">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Glyph="{StaticResource Icon.Undo}" Size="16" Margin="0,0,6,0" />
                            <TextBlock Text="Undo" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding Toast}" Foreground="White" FontSize="15" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,6" />
                </DockPanel>
            </c:ShadowBorder>
        </Grid>
    </Grid>
</Window>
