<UserControl x:Class="CraftLibrary.App.Views.PreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CraftLibrary.App.Controls"
             TextElement.FontFamily="{DynamicResource F.preview}" x:Name="Me">
    <Border Background="{DynamicResource B.panel}" BorderBrush="{DynamicResource B.border}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderThickness" Value="1,0,0,0" />
                <Setter Property="Width" Value="400" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding PreviewBottom}" Value="True">
                        <Setter Property="BorderThickness" Value="0,1,0,0" />
                        <Setter Property="Width" Value="NaN" />
                        <Setter Property="Height" Value="340" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding PreviewPopout}" Value="True">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Width" Value="NaN" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="20,16,20,24">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <!-- At the bottom of the window the panel is very wide: keep it to a comfortable reading width. -->
                            <DataTrigger Binding="{Binding PreviewBottom}" Value="True">
                                <Setter Property="MaxWidth" Value="620" />
                                <Setter Property="HorizontalAlignment" Value="Left" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <!-- Heading -->
                <DockPanel Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource Btn.Link}" Command="{Binding PopOut}" Visibility="{Binding PreviewPopout, Converter={StaticResource Vis}, ConverterParameter=not}">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Glyph="{StaticResource Icon.PopOut}" Size="16" Margin="0,0,6,0" />
                                <TextBlock Text="Pop out" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Btn.Link}" Command="{Binding DockPreview}" Visibility="{Binding PreviewPopout, Converter={StaticResource Vis}}" Content="Put back in the window" />
                        <Button Style="{StaticResource Btn.Link}" Command="{Binding HidePreview}" Content="Hide" Margin="8,0,0,0" Visibility="{Binding PreviewPopout, Converter={StaticResource Vis}}" />
                        <Button Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding HidePreview}" Foreground="{DynamicResource B.muted}" Margin="6,-4,-8,-4"
                                ToolTip="Hide the preview" ToolTipService.IsEnabled="True" AutomationProperties.Name="Hide the preview"
                                Visibility="{Binding PreviewPopout, Converter={StaticResource Vis}, ConverterParameter=not}">
                            <!-- Points the way the panel goes: right, or down when it's at the bottom -->
                            <c:Icon Size="18">
                                <c:Icon.Style>
                                    <Style TargetType="c:Icon">
                                        <Setter Property="Glyph" Value="{StaticResource Icon.ChevronRight}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PreviewBottom}" Value="True">
                                                <Setter Property="Glyph" Value="{StaticResource Icon.ChevronDown}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </c:Icon.Style>
                            </c:Icon>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="PREVIEW" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center" />
                </DockPanel>

                <!-- Nothing chosen -->
                <TextBlock Text="Click a file to see a big preview and its details." Style="{StaticResource Muted}" FontSize="14" Visibility="{Binding NoSel, Converter={StaticResource Vis}}" />

                <!-- A folder tile is chosen -->
                <StackPanel Visibility="{Binding HasTileSel, Converter={StaticResource Vis}}">
                    <Border Height="200" CornerRadius="14" Background="{DynamicResource B.subtle}">
                        <c:Icon Glyph="{StaticResource Icon.Folder}" Size="110" Thickness="1" Fill="{Binding TileSelFill, Converter={StaticResource Hex}}" Stroke="{Binding TileSelLine, Converter={StaticResource Hex}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding TileSelLabel}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" Margin="0,14,0,2" />
                    <TextBlock Text="{Binding TileSelMeta}" Style="{StaticResource Muted}" FontSize="14" />
                    <Button Style="{StaticResource Btn.Primary}" Command="{Binding OpenTile}" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Glyph="{StaticResource Icon.Folder}" Size="18" Margin="0,0,8,0" />
                            <TextBlock Text="Open folder" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Tip: double-click a folder to open it." Style="{StaticResource Muted}" Margin="0,12,0,0" />
                </StackPanel>

                <!-- A file is chosen -->
                <StackPanel Visibility="{Binding HasSel, Converter={StaticResource Vis}}">
                    <Border Height="230" CornerRadius="14" Background="{DynamicResource B.subtle}" BorderBrush="{DynamicResource B.border}" BorderThickness="1">
                        <Grid>
                            <Border Margin="12" Background="{Binding PreviewImage, Converter={StaticResource ThumbFill}}" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding Selected.IsFont, Converter={StaticResource Vis}}">
                                <TextBlock Text="Aa" FontFamily="{Binding Selected.FontPreview}" FontSize="72" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding Selected.ShowGeneric, Converter={StaticResource Vis}}">
                                <c:Icon Glyph="{StaticResource Icon.Note}" Size="64" Thickness="1.2" Foreground="{DynamicResource B.muted}" HorizontalAlignment="Center" />
                                <TextBlock Text="No preview" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource B.muted}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                            <Border Style="{StaticResource TypeBadge}">
                                <TextBlock Text="{Binding Selected.TypeBadge}" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Name and Rename -->
                    <DockPanel Margin="0,14,0,0" Visibility="{Binding Renaming, Converter={StaticResource Vis}, ConverterParameter=not}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Plain}" Command="{Binding StartRename}" Margin="12,0,0,0" VerticalAlignment="Top"
                                Visibility="{Binding FeatRename, Converter={StaticResource Vis}}" ToolTip="Give this file a new name">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Glyph="{StaticResource Icon.Pencil}" Size="16" Margin="0,0,8,0" Visibility="{DynamicResource V.btnIcon}" />
                                <TextBlock Text="Rename" Visibility="{DynamicResource V.btnWord}" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding Selected.FullName}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                    <StackPanel Margin="0,14,0,0" Visibility="{Binding Renaming, Converter={StaticResource Vis}}">
                        <TextBlock Text="Type the new name" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Background="{DynamicResource B.subtle}" CornerRadius="8" Padding="8,0" Margin="8,0,0,0">
                                <TextBlock Text="{Binding Selected.Ext, StringFormat=.{0}}" VerticalAlignment="Center" Foreground="{DynamicResource B.muted}" />
                            </Border>
                            <TextBox x:Name="RenameBox" Style="{StaticResource Field}" Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" c:Ui.FocusOnShow="True" KeyDown="OnRenameKey" />
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource Btn.Primary}" Content="Save name" Command="{Binding SaveName}" Margin="0,0,10,0" />
                            <Button Style="{StaticResource Btn.Plain}" Content="Cancel" Command="{Binding CancelRename}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- File options -->
                    <Grid Margin="0,14,0,0">
                        <ToggleButton x:Name="OptionsBtn" Style="{StaticResource Btn.Primary}" IsChecked="{Binding FileOptionsOpen}" MinHeight="46" ToolTip="Move, open, set aside or remove this file"
                                      IsHitTestVisible="{Binding IsOpen, ElementName=OptionsPopup, Converter={StaticResource Not}}">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Glyph="{StaticResource Icon.FolderMove}" Size="18" Margin="0,0,8,0" />
                                <TextBlock Text="File options" />
                                <c:Icon Glyph="{StaticResource Icon.ChevronDown}" Size="16" Margin="8,0,0,0" />
                            </StackPanel>
                        </ToggleButton>
                        <Popup x:Name="OptionsPopup" IsOpen="{Binding FileOptionsOpen}" StaysOpen="False" PlacementTarget="{Binding ElementName=OptionsBtn}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
                            <c:ShadowBorder Style="{StaticResource PopupCard}" Width="{Binding ActualWidth, ElementName=OptionsBtn}" Margin="0,6,0,24">
                                <StackPanel>
                                    <Button Style="{StaticResource Btn.Row}" Command="{Binding OpenMove}" Visibility="{Binding FeatMove, Converter={StaticResource Vis}}" ToolTip="Pick the folder this file belongs in">
                                        <DockPanel>
                                            <c:Icon Glyph="{StaticResource Icon.FolderMove}" Size="18" Margin="4,0,12,0" />
                                            <TextBlock Text="Move to…" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Button>
                                    <Button Style="{StaticResource Btn.Row}" Command="{Binding OpenSelected}" Visibility="{Binding FeatOpen, Converter={StaticResource Vis}}" ToolTip="Open this file in its usual program">
                                        <DockPanel>
                                            <c:Icon Glyph="{StaticResource Icon.PopOut}" Size="18" Margin="4,0,12,0" />
                                            <TextBlock Text="{Binding OpenLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </Button>
                                    <Button Style="{StaticResource Btn.Row}" Command="{Binding ToggleOpenWith}" Visibility="{Binding FeatOpen, Converter={StaticResource Vis}}">
                                        <DockPanel>
                                            <c:Icon DockPanel.Dock="Right" Glyph="{StaticResource Icon.ChevronDown}" Size="16" Margin="0,0,4,0" />
                                            <c:Icon Glyph="{StaticResource Icon.Grid4}" Size="18" Margin="4,0,12,0" />
                                            <TextBlock Text="Open with…" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Button>
                                    <Border BorderBrush="{DynamicResource B.border}" BorderThickness="2,0,0,0" Margin="24,0,0,6" Padding="10,0,0,0" Visibility="{Binding OpenWithOpen, Converter={StaticResource Vis}}">
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding ProgramChoices}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource Btn.Row}" Command="{Binding Open}" FontSize="14">
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Right" Text="Default" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource B.muted}" VerticalAlignment="Center" Visibility="{Binding IsDefault, Converter={StaticResource Vis}}" />
                                                                <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource B.accent-soft}" Margin="0,0,10,0">
                                                                    <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource B.accent-strong}" />
                                                                </Border>
                                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                            </DockPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Style="{StaticResource Btn.Link}" Content="Choose another program…" Command="{Binding ChooseOtherProgram}" HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </Border>
                                    <Button Style="{StaticResource Btn.Row}" Command="{Binding ToggleLater}" Visibility="{Binding FeatLater, Converter={StaticResource Vis}}">
                                        <DockPanel>
                                            <c:Icon Glyph="{StaticResource Icon.Clock}" Size="18" Margin="4,0,12,0" />
                                            <TextBlock Text="{Binding Selected.LaterLabel}" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Button>
                                    <Button Style="{StaticResource Btn.Row}" Command="{Binding ShowInExplorer}" Visibility="{Binding FeatExplorer, Converter={StaticResource Vis}}">
                                        <DockPanel>
                                            <c:Icon Glyph="{StaticResource Icon.FolderSearch}" Size="18" Margin="4,0,12,0" />
                                            <TextBlock Text="Show in File Explorer" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Button>
                                    <Rectangle Height="1" Fill="{DynamicResource B.line}" Margin="8,4" Visibility="{Binding FeatRecycle, Converter={StaticResource Vis}}" />
                                    <Button Style="{StaticResource Btn.Row}" Command="{Binding RecycleSelected}" Visibility="{Binding FeatRecycle, Converter={StaticResource Vis}}">
                                        <DockPanel>
                                            <c:Icon Glyph="{StaticResource Icon.Trash}" Size="18" Margin="4,0,12,0" />
                                            <TextBlock Text="Send to Recycle Bin" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Button>
                                </StackPanel>
                            </c:ShadowBorder>
                        </Popup>
                    </Grid>

                    <!-- Details -->
                    <Grid Margin="0,16,0,0" TextElement.FontSize="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Type" Foreground="{DynamicResource B.muted}" Margin="0,0,0,6" />
                        <TextBlock Grid.Column="1" Text="{Binding Selected.TypeLabel}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Text="Size" Foreground="{DynamicResource B.muted}" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Selected.Size}" />
                        <TextBlock Grid.Row="2" Text="Folder" Foreground="{DynamicResource B.muted}" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PreviewFolderPath}" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Grid.Row="3" Text="Added" Foreground="{DynamicResource B.muted}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Selected.Added}" />
                    </Grid>

                    <!-- Copies -->
                    <Border Background="{DynamicResource B.warn-soft}" BorderBrush="{DynamicResource B.warn-line}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,14,0,0"
                            Visibility="{Binding PreviewIsDup, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding Selected.CopiesText}" FontWeight="Bold" Foreground="{DynamicResource B.warn-ink}" />
                            <TextBlock Text="{Binding PreviewDupText}" Foreground="{DynamicResource B.warn-ink}" TextWrapping="Wrap" Margin="0,2,0,8" />
                            <Button Style="{StaticResource Btn.Plain}" Content="See duplicates" HorizontalAlignment="Left" Click="OnSeeDuplicates" />
                        </StackPanel>
                    </Border>

                    <!-- Sort later -->
                    <Border Background="{DynamicResource B.accent-soft}" CornerRadius="999" Padding="12,4" Margin="0,12,0,0" HorizontalAlignment="Left" Visibility="{Binding Selected.Later, Converter={StaticResource Vis}}">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Glyph="{StaticResource Icon.Clock}" Size="14" Foreground="{DynamicResource B.accent-strong}" Margin="0,0,6,0" />
                            <TextBlock Text="Saved to sort later" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource B.accent-strong}" />
                        </StackPanel>
                    </Border>

                    <!-- Font files -->
                    <StackPanel Margin="0,16,0,0" Visibility="{Binding Selected.IsFont, Converter={StaticResource Vis}}">
                        <TextBlock Text="Happy Birthday" FontFamily="{Binding Selected.FontPreview}" FontSize="28" TextWrapping="Wrap" />
                        <TextBlock Text="The quick brown fox jumps over the lazy dog. 0123456789" FontFamily="{Binding Selected.FontPreview}" FontSize="17" TextWrapping="Wrap" Margin="0,4,0,10" />
                        <StackPanel Orientation="Horizontal" Visibility="{Binding Selected.Installed, Converter={StaticResource Vis}}">
                            <c:Icon Glyph="{StaticResource Icon.Check}" Size="16" Foreground="{DynamicResource B.accent-text}" Margin="0,0,6,0" />
                            <TextBlock Text="Installed on this computer" FontWeight="SemiBold" Foreground="{DynamicResource B.accent-text}" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding Selected.FontNotInstalled, Converter={StaticResource Vis}}">
                            <Button Style="{StaticResource Btn.Plain}" Command="{Binding InstallFont}" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Glyph="{StaticResource Icon.Download}" Size="16" Margin="0,0,8,0" />
                                    <TextBlock Text="Install font" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="Installs for your Windows account, so it works in other programs too." Style="{StaticResource Muted}" Margin="0,6,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Her own note -->
                    <StackPanel Margin="0,16,0,0" Visibility="{Binding FeatNotes, Converter={StaticResource Vis}}">
                        <TextBlock Text="My note" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource Field.Multi}" Text="{Binding SelectedNote, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="Jot something down, like which card this is for" />
                    </StackPanel>

                    <!-- Explanation -->
                    <Border Background="{DynamicResource B.subtle}" CornerRadius="12" Padding="12,10" Margin="0,12,0,0" Visibility="{Binding PreviewNote, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding PreviewNote}" FontSize="14" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
