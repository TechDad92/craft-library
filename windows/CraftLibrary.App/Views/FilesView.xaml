<UserControl x:Class="CraftLibrary.App.Views.FilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CraftLibrary.App.Controls"
             xmlns:vm="clr-namespace:CraftLibrary.App.ViewModels"
             TextElement.FontFamily="{DynamicResource F.files}">
    <UserControl.Resources>
        <!-- ===== Pictures used when there is no thumbnail ===== -->
        <DataTemplate x:Key="ThumbBox" DataType="{x:Type vm:FileItemVm}">
            <Grid>
                <!-- Paper patterns fill the box; other files are shown whole on white. -->
                <Border x:Name="Pic" CornerRadius="11,11,0,0" Background="{Binding Thumb, Converter={StaticResource ThumbFill}, ConverterParameter=cover}" />
                <!-- Font: written in itself -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsFont, Converter={StaticResource Vis}}">
                    <TextBlock Text="Aa" FontFamily="{Binding FontPreview}" FontSize="48" FontWeight="SemiBold" Foreground="#1C2430" HorizontalAlignment="Center" />
                    <TextBlock Text="Happy Birthday" FontFamily="{Binding FontPreview}" FontSize="15" Foreground="#566170" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
                <!-- No preview -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding ShowGeneric, Converter={StaticResource Vis}}">
                    <c:Icon Glyph="{StaticResource Icon.Note}" Size="44" Thickness="1.4" Foreground="#566170" HorizontalAlignment="Center" />
                    <TextBlock Text="No preview" FontSize="12" FontWeight="SemiBold" Foreground="#566170" HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
                <!-- "6 files inside" on zip bundles -->
                <c:ShadowBorder VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,10" Background="White" CornerRadius="999" Padding="10,2"
                        Visibility="{Binding HasInner, Converter={StaticResource Vis}}" ShadowSize="6" ShadowDrop="2" ShadowOpacity="0.3">
                    <TextBlock Text="{Binding InnerText}" FontSize="12" FontWeight="SemiBold" Foreground="#1C2430" />
                </c:ShadowBorder>
                <Border Style="{StaticResource TypeBadge}">
                    <TextBlock Text="{Binding TypeBadge}" />
                </Border>
                <Border Style="{StaticResource WarnBadge}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Visibility="{Binding ShowCopies, Converter={StaticResource Vis}}">
                    <StackPanel Orientation="Horizontal">
                        <c:Icon Glyph="{StaticResource Icon.Copy}" Size="13" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding CopiesText}" />
                    </StackPanel>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCover}" Value="False">
                    <Setter TargetName="Pic" Property="Background" Value="{Binding Thumb, Converter={StaticResource ThumbFill}}" />
                    <Setter TargetName="Pic" Property="Margin" Value="10" />
                    <Setter TargetName="Pic" Property="CornerRadius" Value="0" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== A file tile in the grid ===== -->
        <DataTemplate x:Key="FileTile" DataType="{x:Type vm:FileItemVm}">
            <Border x:Name="Card" Margin="0,0,0,0" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource B.border}" Background="{DynamicResource B.panel}"
                    Cursor="Hand" MouseLeftButtonDown="OnTileDown" ContextMenuOpening="OnTileMenu" Tag="{Binding}" ToolTip="{Binding FullName}" ToolTipService.InitialShowDelay="900">
                <DockPanel>
                    <Border DockPanel.Dock="Top" x:Name="Box" Height="{Binding DataContext.ThumbHeight, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CornerRadius="11,11,0,0" Background="#FFFFFF">
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ThumbBox}" />
                    </Border>
                    <StackPanel Margin="{DynamicResource CaptionPad}">
                        <TextBlock Text="{Binding FullName}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding DataContext.ShowNameOn, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource Vis}}" />
                        <TextBlock Text="{Binding MetaLine}" FontSize="12" Foreground="{DynamicResource B.muted}" Margin="0,4,0,0" Visibility="{Binding MetaLine, Converter={StaticResource Vis}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding Later, Converter={StaticResource Vis}}">
                            <c:Icon Glyph="{StaticResource Icon.Clock}" Size="14" Foreground="{DynamicResource B.accent-text}" Margin="0,0,4,0" />
                            <TextBlock Text="Sort later" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource B.accent-text}" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCover}" Value="True">
                    <Setter TargetName="Box" Property="Background" Value="#EEF0F3" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource B.accent-line}" />
                    <Setter TargetName="Card" Property="BorderThickness" Value="3" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ===== A folder tile in the grid ===== -->
        <DataTemplate x:Key="FolderTile" DataType="{x:Type vm:FolderTileVm}">
            <Border x:Name="Card" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource B.border}" Background="{DynamicResource B.panel}"
                    Cursor="Hand" MouseLeftButtonDown="OnTileDown" ContextMenuOpening="OnTileMenu" Tag="{Binding}" ToolTip="Double-click to open">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Height="{Binding DataContext.ThumbHeight, RelativeSource={RelativeSource AncestorType=ListBox}}" CornerRadius="11,11,0,0" Background="{DynamicResource B.subtle}">
                        <c:Icon Glyph="{StaticResource Icon.Folder}" Size="72" Thickness="1.2" Fill="{Binding Fill, Converter={StaticResource Hex}}" Stroke="{Binding Line, Converter={StaticResource Hex}}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="{DynamicResource CaptionPad}">
                        <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Meta}" FontSize="12" Foreground="{DynamicResource B.muted}" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource B.accent-line}" />
                    <Setter TargetName="Card" Property="BorderThickness" Value="3" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <ListBox x:Name="List" Style="{StaticResource FastList}" ItemsSource="{Binding Rows}" SizeChanged="OnSizeChanged" PreviewKeyDown="OnKey" Focusable="True"
             AutomationProperties.Name="Files">
        <ListBox.Resources>
            <!-- The heading: path, title, count, buttons, note, tip -->
            <DataTemplate DataType="{x:Type vm:HeaderRow}">
                <StackPanel Margin="24,20,24,16" DataContext="{Binding Main}">
                    <ItemsControl ItemsSource="{Binding Crumbs}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="›" Margin="6,0" Foreground="{DynamicResource B.muted}" FontSize="13" VerticalAlignment="Center" Visibility="{Binding Sep, Converter={StaticResource Vis}}" />
                                    <TextBlock FontSize="13" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource B.muted}" />
                                                <Setter Property="Text" Value="{Binding Label}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLink}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button Style="{StaticResource Btn.Link}" MinHeight="0" Padding="2,0" FontSize="13" Command="{Binding Open}" Visibility="{Binding IsLink, Converter={StaticResource Vis}}">
                                        <TextBlock Text="{Binding Label}" TextDecorations="Underline" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding ListTitle}" FontSize="26" FontWeight="Bold" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ListCount}" FontSize="14" Foreground="{DynamicResource B.muted}" Margin="0,2,0,0" />

                    <WrapPanel Margin="0,12,0,0" Visibility="{Binding FolderExtras, Converter={StaticResource Vis}}">
                        <Button Style="{StaticResource Btn.Plain}" Command="{Binding StartFolderNote}" Margin="0,0,10,0" Visibility="{Binding FeatNotes, Converter={StaticResource Vis}}">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Glyph="{StaticResource Icon.Note}" Size="18" Margin="0,0,8,0" Visibility="{DynamicResource V.btnIcon}" />
                                <TextBlock Text="{Binding FolderNoteButton}" Visibility="{DynamicResource V.btnWord}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Btn.Plain}" Command="{Binding OpenColour}" Margin="0,0,10,0" Visibility="{Binding FeatLabels, Converter={StaticResource Vis}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="16" Height="16" Margin="0,0,8,0" Stroke="{DynamicResource B.ctl}" StrokeThickness="1.5" Fill="{Binding CurrentColour, Converter={StaticResource Hex}}" />
                                <TextBlock Text="{Binding ColourButtonText}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Btn.Plain}" Command="{Binding ShowPreview}" Visibility="{Binding PreviewHidden, Converter={StaticResource Vis}}">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Glyph="{StaticResource Icon.Window}" Size="18" Margin="0,0,8,0" Visibility="{DynamicResource V.btnIcon}" />
                                <TextBlock Text="Show preview" Visibility="{DynamicResource V.btnWord}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <!-- Note on this folder -->
                    <Border Background="{DynamicResource B.warn-soft}" BorderBrush="{DynamicResource B.warn-line}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,12,0,0" MaxWidth="760" HorizontalAlignment="Left"
                            Visibility="{Binding ShowFolderNote, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding FolderNote}" FontSize="14" TextWrapping="Wrap" />
                    </Border>
                    <StackPanel Margin="0,12,0,0" MaxWidth="760" HorizontalAlignment="Stretch" Visibility="{Binding EditingFolderNote, Converter={StaticResource Vis}}">
                        <TextBlock Text="Note for this folder" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource Field.Multi}" Text="{Binding FolderNoteDraft, UpdateSourceTrigger=PropertyChanged}" c:Ui.FocusOnShow="True" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource Btn.Primary}" Content="Save note" Command="{Binding SaveFolderNote}" Margin="0,0,10,0" />
                            <Button Style="{StaticResource Btn.Plain}" Content="Cancel" Command="{Binding CancelFolderNote}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Tip shown in "To sort" -->
                    <Border Background="{DynamicResource B.info-bg}" BorderBrush="{DynamicResource B.info-line}" BorderThickness="1" CornerRadius="12" Padding="14,6,6,6" Margin="0,16,0,0"
                            Visibility="{Binding ShowInboxHint, Converter={StaticResource Vis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Foreground="{DynamicResource B.info-ink}" Command="{Binding DismissInboxHint}" AutomationProperties.Name="Dismiss tip" VerticalAlignment="Top">
                                <c:Icon Glyph="{StaticResource Icon.Close}" Size="18" />
                            </Button>
                            <c:Icon DockPanel.Dock="Left" Glyph="{StaticResource Icon.Info}" Size="18" Foreground="{DynamicResource B.info-ink}" VerticalAlignment="Top" Margin="0,8,10,0" />
                            <TextBlock FontSize="14" Foreground="{DynamicResource B.info-ink}" TextWrapping="Wrap" Margin="0,7,0,7">
                                These are new files waiting to be put away. Click a file to see it in the preview, then use <Bold>Move to…</Bold> to file it.
                                Double-click a file to open it. Not sure where something goes yet? Use <Bold>Sort later</Bold> to set it aside.
                            </TextBlock>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>

            <!-- A row of tiles -->
            <DataTemplate DataType="{x:Type vm:GridRow}">
                <ItemsControl ItemsSource="{Binding Tiles}" Margin="{DynamicResource RowMargin}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="{Binding Cols}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="{DynamicResource TileMargin}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplateSelector>
                        <c:TileSelector FileTemplate="{StaticResource FileTile}" FolderTemplate="{StaticResource FolderTile}" />
                    </ItemsControl.ItemTemplateSelector>
                </ItemsControl>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:EmptyRow}">
                <TextBlock Text="{Binding Text}" FontSize="16" Foreground="{DynamicResource B.muted}" Margin="24,40" HorizontalAlignment="Center" />
            </DataTemplate>

            <!-- List view: one file per row -->
            <DataTemplate DataType="{x:Type vm:FileItemVm}">
                <Border x:Name="Row" Margin="24,0,24,6" CornerRadius="10" Background="{DynamicResource B.panel}" BorderBrush="{DynamicResource B.border}" BorderThickness="1" Padding="8"
                        Cursor="Hand" MouseLeftButtonDown="OnTileDown" ContextMenuOpening="OnTileMenu" Tag="{Binding}">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="64" Height="48" CornerRadius="8" Background="#FFFFFF" ClipToBounds="True" Margin="0,0,14,0">
                            <Grid>
                                <Border CornerRadius="8" Background="{Binding Thumb, Converter={StaticResource ThumbFill}, ConverterParameter=cover}" />
                                <TextBlock Text="Aa" FontFamily="{Binding FontPreview}" FontSize="22" Foreground="#1C2430" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsFont, Converter={StaticResource Vis}}" />
                                <c:Icon Glyph="{StaticResource Icon.Note}" Size="24" Thickness="1.6" Foreground="#566170" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowGeneric, Converter={StaticResource Vis}}" />
                            </Grid>
                        </Border>
                        <Border DockPanel.Dock="Right" Style="{StaticResource WarnBadge}" VerticalAlignment="Center" Margin="10,0,6,0" Visibility="{Binding ShowCopies, Converter={StaticResource Vis}}">
                            <TextBlock Text="{Binding CopiesText}" />
                        </Border>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding MetaLine}" Width="190" FontSize="13" Foreground="{DynamicResource B.muted}" VerticalAlignment="Center" TextAlignment="Right" />
                        <TextBlock DockPanel.Dock="Right" Text="{Binding TypeLabel}" Width="170" FontSize="13" Foreground="{DynamicResource B.muted}" VerticalAlignment="Center"
                                   Visibility="{Binding DataContext.ShowTypeOn, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource Vis}}" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding FullName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Sort later" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource B.accent-text}" Visibility="{Binding Later, Converter={StaticResource Vis}}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource B.accent-soft}" />
                        <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource B.accent-line}" />
                        <Setter TargetName="Row" Property="BorderThickness" Value="2" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:FolderTileVm}">
                <Border x:Name="Row" Margin="24,0,24,6" CornerRadius="10" Background="{DynamicResource B.panel}" BorderBrush="{DynamicResource B.border}" BorderThickness="1" Padding="8"
                        Cursor="Hand" MouseLeftButtonDown="OnTileDown" ContextMenuOpening="OnTileMenu" Tag="{Binding}">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="64" Height="48" CornerRadius="8" Background="{DynamicResource B.subtle}" Margin="0,0,14,0">
                            <c:Icon Glyph="{StaticResource Icon.Folder}" Size="30" Thickness="1.5" Fill="{Binding Fill, Converter={StaticResource Hex}}" Stroke="{Binding Line, Converter={StaticResource Hex}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Meta}" FontSize="13" Foreground="{DynamicResource B.muted}" VerticalAlignment="Center" Margin="10,0,6,0" />
                        <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource B.accent-soft}" />
                        <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource B.accent-line}" />
                        <Setter TargetName="Row" Property="BorderThickness" Value="2" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ListBox.Resources>
    </ListBox>
</UserControl>
