<UserControl x:Class="CraftLibrary.App.Views.DialogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CraftLibrary.App.Controls"
             TextElement.FontFamily="{DynamicResource F.popups}">
    <UserControl.Resources>
        <!-- Dims the app behind a pop-up window. Clicking the dimmed part does nothing, so nothing is lost by accident. -->
        <Style x:Key="Backdrop" TargetType="Grid">
            <Setter Property="Background" Value="#7A0F172A" />
        </Style>
        <Style x:Key="Dialog" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Effect" Value="{StaticResource Shadow}" />
            <Setter Property="Margin" Value="24" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- ===================== Move to… ===================== -->
        <Grid Style="{StaticResource Backdrop}" Visibility="{Binding MoveOpen, Converter={StaticResource Vis}}">
            <Border Style="{StaticResource Dialog}" Width="580" MaxHeight="640">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="22,20,22,14">
                        <TextBlock Text="{Binding MoveTitle}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Text="Pick the folder this file belongs in." Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,0" />
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource B.border}" BorderThickness="0,1,0,0" Padding="22,14">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource Btn.Plain}" Content="Cancel" Command="{Binding CloseMove}" Margin="0,0,10,0" IsCancel="True" />
                            <Button Style="{StaticResource Btn.Primary}" Content="{Binding MoveButtonText}" Command="{Binding MoveHere}" IsEnabled="{Binding CanMoveHere}" />
                        </StackPanel>
                    </Border>
                    <Border BorderBrush="{DynamicResource B.border}" BorderThickness="0,1,0,0">
                        <ListBox Style="{StaticResource FastList}" ItemsSource="{Binding MoveRows}" Padding="14,8">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <StackPanel Margin="10,12,10,4" Visibility="{Binding IsHeader, Converter={StaticResource Vis}}">
                                            <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="Bold" />
                                            <TextBlock Text="{Binding Path}" FontSize="12" Foreground="{DynamicResource B.muted}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Style="{StaticResource Btn.Row}" c:Ui.Active="{Binding IsTarget}" Command="{Binding Pick}" Margin="{Binding Indent}"
                                                Visibility="{Binding IsHeader, Converter={StaticResource Vis}, ConverterParameter=not}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="Current folder" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource B.muted}" VerticalAlignment="Center"
                                                           Visibility="{Binding IsCurrent, Converter={StaticResource Vis}}" />
                                                <c:Icon Glyph="{StaticResource Icon.Folder}" Size="18" Margin="4,0,12,0" />
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource B.muted}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DockPanel>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===================== Are you sure? ===================== -->
        <Grid Style="{StaticResource Backdrop}" Visibility="{Binding ConfirmOpen, Converter={StaticResource Vis}}">
            <Border Style="{StaticResource Dialog}" Width="500" Padding="24,22">
                <StackPanel>
                    <TextBlock Text="{Binding ConfirmTitle}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock Text="You can get it back from the Windows Recycle Bin, or with Undo." Style="{StaticResource Muted}" FontSize="14" Margin="0,8,0,0" />
                    <Border Background="{DynamicResource B.warn-soft}" BorderBrush="{DynamicResource B.warn-line}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,12,0,0"
                            Visibility="{Binding ConfirmPortable, Converter={StaticResource Vis}}">
                        <TextBlock FontSize="14" Foreground="{DynamicResource B.warn-ink}" TextWrapping="Wrap"
                                   Text="Some of this is on a portable drive, which has no Recycle Bin. It will go into a “Removed files” folder on that drive instead, so you can still get it back." />
                    </Border>
                    <CheckBox Style="{StaticResource Check}" IsChecked="{Binding ConfirmDontAsk}" Margin="0,16,0,0">
                        <TextBlock Text="Don't ask me again" FontSize="14" />
                    </CheckBox>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Style="{StaticResource Btn.Plain}" Content="Cancel" Command="{Binding ConfirmNo}" Margin="0,0,10,0" IsCancel="True" />
                        <Button Style="{StaticResource Btn.Danger}" Command="{Binding ConfirmYes}">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Glyph="{StaticResource Icon.Trash}" Size="16" Margin="0,0,8,0" />
                                <TextBlock Text="Remove" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===================== Colour label ===================== -->
        <Grid Style="{StaticResource Backdrop}" Visibility="{Binding ColourOpen, Converter={StaticResource Vis}}">
            <Border Style="{StaticResource Dialog}" Width="520" Padding="24,22">
                <StackPanel>
                    <TextBlock Text="{Binding ColourDialogTitle}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,8">
                        <c:Icon Glyph="{StaticResource Icon.Folder}" Size="36" Thickness="1.4" Fill="{Binding CurrentColour, Converter={StaticResource Hex}}" Margin="0,0,12,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentFolder.Label}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CurrentColourName}" Style="{StaticResource Muted}" />
                        </StackPanel>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding ColourTabs}" Focusable="False" Margin="0,8,0,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Btn.Seg}" c:Ui.Active="{Binding On}" Command="{Binding Pick}" Content="{Binding Label}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding ColourSwatches}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Btn.Swatch}" Background="{Binding Hex, Converter={StaticResource Hex}}" c:Ui.Active="{Binding On}" Command="{Binding Pick}"
                                        ToolTip="{Binding Label}" ToolTipService.IsEnabled="True" AutomationProperties.Name="{Binding Label}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Custom colour" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <Border Width="42" Height="42" CornerRadius="10" BorderBrush="{DynamicResource B.border}" BorderThickness="1" Background="{Binding CustomColour, Converter={StaticResource Hex}}" Margin="0,0,10,0" />
                        <TextBox Style="{StaticResource Field}" Width="130" Text="{Binding CustomColour, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Custom colour code" />
                        <Button Style="{StaticResource Btn.Plain}" Content="Use this colour" Command="{Binding UseCustomColour}" Margin="10,0,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button Style="{StaticResource Btn.Plain}" Content="Remove colour" Command="{Binding RemoveColour}" Margin="0,0,10,0" />
                        <Button Style="{StaticResource Btn.Primary}" Content="Done" Command="{Binding CloseColour}" IsCancel="True" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===================== History ===================== -->
        <Grid Style="{StaticResource Backdrop}" Visibility="{Binding HistoryOpen, Converter={StaticResource Vis}}">
            <Border Style="{StaticResource Dialog}" Width="620" MaxHeight="640">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="22,20,22,14">
                        <TextBlock Text="History" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="Everything you've done, newest first. “Undo back to here” undoes that step and everything after it." Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,0" />
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource B.border}" BorderThickness="0,1,0,0" Padding="22,14">
                        <Button Style="{StaticResource Btn.Plain}" Content="Close" Command="{Binding CloseHistory}" HorizontalAlignment="Right" IsCancel="True" />
                    </Border>
                    <Grid>
                        <TextBlock Text="Nothing yet. Moves, renames and removals will show up here." Style="{StaticResource Muted}" FontSize="14" Margin="22,10" Visibility="{Binding HistoryEmpty, Converter={StaticResource Vis}}" />
                        <ListBox Style="{StaticResource FastList}" ItemsSource="{Binding HistoryRows}" Padding="22,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource B.line}" BorderThickness="0,1,0,0" Padding="0,10">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Plain}" Content="{Binding UndoLabel}" Command="{Binding Undo}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Width="70" FontSize="13" Foreground="{DynamicResource B.muted}" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding Msg}" FontSize="14" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ===================== Font picker ===================== -->
        <Grid Style="{StaticResource Backdrop}" DataContext="{Binding SettingsVm}" Visibility="{Binding PickerOpen, Converter={StaticResource Vis}}">
            <Border Style="{StaticResource Dialog}" Width="560" Height="640">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="22,20,22,12">
                        <TextBlock Text="{Binding PickerTitle}" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="Each font is shown in its own style." Style="{StaticResource Muted}" FontSize="14" Margin="0,4,0,10" />
                        <Grid>
                            <TextBox Style="{StaticResource Field}" Padding="36,8,12,8" Text="{Binding PickerQuery, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="Search fonts" c:Ui.FocusOnShow="True" AutomationProperties.Name="Search fonts" />
                            <c:Icon Glyph="{StaticResource Icon.Search}" Size="16" Foreground="{DynamicResource B.muted}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource B.border}" BorderThickness="0,1,0,0" Padding="22,14">
                        <Button Style="{StaticResource Btn.Plain}" Content="Close" Command="{Binding ClosePicker}" HorizontalAlignment="Right" IsCancel="True" />
                    </Border>
                    <Grid>
                        <TextBlock Text="No fonts match that search." Style="{StaticResource Muted}" FontSize="14" Margin="22,10" Visibility="{Binding PickerEmpty, Converter={StaticResource Vis}}" />
                        <ListBox Style="{StaticResource FastList}" ItemsSource="{Binding PickerRows}" Padding="14,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource SectionLabel}" Margin="10,14,10,6" Visibility="{Binding IsHeader, Converter={StaticResource Vis}}" />
                                        <Button Style="{StaticResource Btn.Row}" c:Ui.Active="{Binding IsCurrent}" Command="{Binding Pick}" Padding="10,6"
                                                Visibility="{Binding IsHeader, Converter={StaticResource Vis}, ConverterParameter=not}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="Current" FontSize="12" Foreground="{DynamicResource B.muted}" VerticalAlignment="Center" Visibility="{Binding IsCurrent, Converter={StaticResource Vis}}" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}" FontSize="15" />
                                                    <TextBlock Text="Happy crafting · Aa Bb Cc 123" FontFamily="{Binding Family}" FontSize="15" FontWeight="Normal" Foreground="{DynamicResource B.muted}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
