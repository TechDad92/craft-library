<!--
    The first-run setup guide: 8 short screens over the app. The app behind stays visible (lightly dimmed) so each
    choice can be seen taking effect. Wording is from docs/plans/first-run-wizard.md: plain words, no jargon.
    DataContext: SetupGuideViewModel.
-->
<UserControl x:Class="CraftLibrary.App.Views.SetupGuideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CraftLibrary.App.Controls"
             TextElement.FontFamily="{DynamicResource F.popups}">
    <UserControl.Resources>
        <DataTemplate x:Key="Seg">
            <Button Style="{StaticResource Btn.Seg}" c:Ui.Active="{Binding On}" Command="{Binding Pick}" Content="{Binding Label}" />
        </DataTemplate>
        <ItemsPanelTemplate x:Key="Wrap">
            <WrapPanel />
        </ItemsPanelTemplate>
        <Style x:Key="SegList" TargetType="ItemsControl">
            <Setter Property="ItemTemplate" Value="{StaticResource Seg}" />
            <Setter Property="ItemsPanel" Value="{StaticResource Wrap}" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <DataTemplate x:Key="Swatch">
            <Button Style="{StaticResource Btn.Swatch}" Background="{Binding Hex, Converter={StaticResource Hex}}" c:Ui.Active="{Binding On}" Command="{Binding Pick}"
                    ToolTip="{Binding Label}" ToolTipService.IsEnabled="True" AutomationProperties.Name="{Binding Label}" />
        </DataTemplate>
        <DataTemplate x:Key="CheckRow">
            <CheckBox Style="{StaticResource Check}" IsChecked="{Binding On, Mode=OneWay}" Command="{Binding Toggle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Help}" Style="{StaticResource Muted}" FontSize="14" Visibility="{Binding Help, Converter={StaticResource Vis}}" />
                </StackPanel>
            </CheckBox>
        </DataTemplate>
        <!-- Screen heading and the short line under it -->
        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Intro" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource B.muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
        <!-- A choice's name and its one-line explanation -->
        <Style x:Key="Q" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,2" />
        </Style>
        <Style x:Key="Help" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource B.muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </UserControl.Resources>

    <!-- Lightly dimmed, so changes to the app behind can be seen. Clicking outside the card does nothing. -->
    <Grid Background="#5A0F172A">
        <c:ShadowBorder Style="{StaticResource Card}" Width="780" MaxHeight="720" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
            <DockPanel>
                <!-- Step N of 8, with progress dots -->
                <DockPanel DockPanel.Dock="Top" Margin="32,22,32,6">
                    <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Dots}" Focusable="False" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Ellipse x:Name="Dot" Width="10" Height="10" Margin="4,0,0,0" Fill="{DynamicResource B.ctl}" />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="True">
                                        <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource B.accent-line}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding StepText}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource B.muted}" VerticalAlignment="Center" />
                </DockPanel>

                <!-- Back · Skip · Next -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource B.border}" BorderThickness="0,1,0,0" Padding="32,16">
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Style="{StaticResource Btn.Plain}" Command="{Binding Back}" MinHeight="46" Padding="20,0" Visibility="{Binding ShowBack, Converter={StaticResource Vis}}">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Glyph="{StaticResource Icon.Back}" Size="18" Margin="0,0,8,0" />
                                <TextBlock Text="Back" FontSize="16" />
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Primary}" Command="{Binding Next}" IsEnabled="{Binding CanGoNext}" MinHeight="46" Padding="24,0" IsDefault="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding NextText}" FontSize="16" />
                                <c:Icon Glyph="{StaticResource Icon.Forward}" Size="18" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Content="{Binding SkipText}" Command="{Binding Skip}" FontSize="15" Margin="0,0,16,0"
                                Visibility="{Binding ShowSkip, Converter={StaticResource Vis}}" />
                        <Border />
                    </DockPanel>
                </Border>

                <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <Grid Margin="32,10,32,24">

                        <!-- 1. Welcome -->
                        <StackPanel Visibility="{Binding Is1, Converter={StaticResource Vis}}">
                            <Grid Width="64" Height="64" HorizontalAlignment="Left" Margin="0,6,0,18">
                                <Border CornerRadius="16" Background="{DynamicResource B.accent}" BorderBrush="{DynamicResource B.accent-line}" BorderThickness="1" />
                                <Rectangle Margin="5" RadiusX="11" RadiusY="11" Stroke="{DynamicResource B.on-accent}" StrokeThickness="1.5" StrokeDashArray="2 1.6" Opacity="0.6" />
                                <c:Icon Glyph="{StaticResource Icon.Logo}" Size="34" Foreground="{DynamicResource B.on-accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="Welcome to Craft Library" Style="{StaticResource Title}" FontSize="30" />
                            <TextBlock Style="{StaticResource Intro}" FontSize="18" Text="This app helps you find, sort and tidy your craft files: papers, cut files, fonts and more." />
                            <TextBlock Style="{StaticResource Intro}" FontSize="18" Text="Let’s set it up the way you like. It takes about two minutes, and you can change anything later in Settings." />
                        </StackPanel>

                        <!-- 2. Craft folder and "To sort" -->
                        <StackPanel Visibility="{Binding Is2, Converter={StaticResource Vis}}">
                            <TextBlock Text="Where are your craft files?" Style="{StaticResource Title}" />
                            <TextBlock Style="{StaticResource Intro}" Text="Choose the folder that holds your craft files. The app only ever looks inside the folders you choose, so nothing else on the computer is touched." />
                            <Border Background="{DynamicResource B.subtle}" CornerRadius="12" Padding="14,10" Margin="0,0,0,12" Visibility="{Binding HasFolder, Converter={StaticResource Vis}}">
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Glyph="{StaticResource Icon.Check}" Size="18" Foreground="{DynamicResource B.accent-text}" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding CraftFolder}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource Btn.Primary}" Command="{Binding ChooseCraftFolder}" HorizontalAlignment="Left" MinHeight="46" Padding="20,0">
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Glyph="{StaticResource Icon.Folder}" Size="18" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding CraftFolderButton}" FontSize="16" />
                                </StackPanel>
                            </Button>

                            <TextBlock Text="Where do new files arrive?" Style="{StaticResource Q}" Margin="0,30,0,2" />
                            <TextBlock Style="{StaticResource Help}" Text="Files you download usually land in your Downloads folder. The app shows them in “To sort”, ready to put away." />
                            <Border Background="{DynamicResource B.subtle}" CornerRadius="12" Padding="14,10" Margin="0,0,0,12" Visibility="{Binding HasInbox, Converter={StaticResource Vis}}">
                                <StackPanel Orientation="Horizontal">
                                    <c:Icon Glyph="{StaticResource Icon.Inbox}" Size="18" Foreground="{DynamicResource B.accent-text}" Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding InboxFolder}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource Btn.Plain}" Content="Choose a different folder" Command="{Binding ChooseInbox}" HorizontalAlignment="Left" FontSize="15" />
                            <TextBlock Style="{StaticResource Help}" Margin="0,20,0,0" Text="You can add more places later, like a USB stick or portable drive." />
                        </StackPanel>

                        <!-- 3. Easy to read -->
                        <StackPanel Visibility="{Binding Is3, Converter={StaticResource Vis}}">
                            <TextBlock Text="Easy to read" Style="{StaticResource Title}" />
                            <TextBlock Style="{StaticResource Intro}" Text="Pick what’s most comfortable for your eyes. You’ll see the change straight away." />
                            <TextBlock Text="Text size" Style="{StaticResource Q}" Margin="0,0,0,2" />
                            <TextBlock Text="How big the words are." Style="{StaticResource Help}" />
                            <ItemsControl Style="{StaticResource SegList}" ItemsSource="{Binding Options.TextSize}" />
                            <TextBlock Text="Font" Style="{StaticResource Q}" />
                            <TextBlock Text="The style of the letters. Each font is written in its own style, so you can see what it looks like." Style="{StaticResource Help}" />
                            <ComboBox ItemsSource="{Binding FontOptions}" SelectedItem="{Binding SelectedFont}" MinHeight="52" FontSize="16" MaxDropDownHeight="380"
                                      IsTextSearchEnabled="True" TextSearch.TextPath="Label" AutomationProperties.Name="Font"
                                      ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <ComboBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ComboBox.ItemsPanel>
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,3">
                                            <TextBlock Text="{Binding Label}" FontFamily="{Binding Family}" FontSize="18" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding About}" FontSize="13" Foreground="{DynamicResource B.muted}" TextWrapping="Wrap"
                                                       Visibility="{Binding HasAbout, Converter={StaticResource Vis}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Style="{StaticResource Help}" Margin="0,10,0,0"
                                       Text="The first four are made to be easy to read. After them come all the fonts on this computer. Tip: type a letter to jump down the list." />
                        </StackPanel>

                        <!-- 4. Colours -->
                        <StackPanel Visibility="{Binding Is4, Converter={StaticResource Vis}}">
                            <TextBlock Text="Colours" Style="{StaticResource Title}" />
                            <TextBlock Style="{StaticResource Intro}" Text="Make it yours. The app behind this box changes as you choose." />
                            <TextBlock Text="Light or dark" Style="{StaticResource Q}" Margin="0,0,0,2" />
                            <TextBlock Text="Light is bright like paper. Dark is easier on the eyes in the evening." Style="{StaticResource Help}" />
                            <ItemsControl Style="{StaticResource SegList}" ItemsSource="{Binding Options.Theme}" />
                            <TextBlock Text="Colour strength" Style="{StaticResource Q}" />
                            <TextBlock Text="How strong the colours are: soft pastels, gentle muted shades, or bold and bright." Style="{StaticResource Help}" />
                            <ItemsControl Style="{StaticResource SegList}" ItemsSource="{Binding Options.Strength}" />
                            <TextBlock Text="Main colour" Style="{StaticResource Q}" />
                            <TextBlock Text="Used for buttons and highlights." Style="{StaticResource Help}" />
                            <ItemsControl ItemsSource="{Binding Options.Accents}" ItemTemplate="{StaticResource Swatch}" ItemsPanel="{StaticResource Wrap}" Focusable="False" />
                            <TextBlock Text="Background" Style="{StaticResource Q}" />
                            <TextBlock Text="A gentle tint behind everything." Style="{StaticResource Help}" />
                            <ItemsControl ItemsSource="{Binding Options.Tints}" ItemTemplate="{StaticResource Swatch}" ItemsPanel="{StaticResource Wrap}" Focusable="False" />
                        </StackPanel>

                        <!-- 5. How files look -->
                        <StackPanel Visibility="{Binding Is5, Converter={StaticResource Vis}}">
                            <TextBlock Text="How your files look" Style="{StaticResource Title}" />
                            <TextBlock Style="{StaticResource Intro}" Text="Choose how your files are shown when you open a folder." />
                            <TextBlock Text="Show files as" Style="{StaticResource Q}" Margin="0,0,0,2" />
                            <TextBlock Text="Pictures in a grid are easiest to browse. A list shows more files at once, with their details." Style="{StaticResource Help}" />
                            <ItemsControl Style="{StaticResource SegList}" ItemsSource="{Binding Options.View}" />
                            <TextBlock Text="Picture size" Style="{StaticResource Q}" />
                            <TextBlock Text="How big each file’s picture is in the grid." Style="{StaticResource Help}" />
                            <ItemsControl Style="{StaticResource SegList}" ItemsSource="{Binding Options.Thumb}" />
                            <TextBlock Text="Show under each file" Style="{StaticResource Q}" />
                            <TextBlock Text="Tick the details you’d like to see." Style="{StaticResource Help}" />
                            <ItemsControl ItemsSource="{Binding Options.ShowWith}" ItemTemplate="{StaticResource CheckRow}" Focusable="False" />
                            <TextBlock Text="Put files in order by" Style="{StaticResource Q}" />
                            <TextBlock Text="Which files come first in each folder." Style="{StaticResource Help}" />
                            <ItemsControl Style="{StaticResource SegList}" ItemsSource="{Binding Options.Order}" />
                        </StackPanel>

                        <!-- 6. Opening files -->
                        <StackPanel Visibility="{Binding Is6, Converter={StaticResource Vis}}">
                            <TextBlock Text="Opening your files" Style="{StaticResource Title}" />
                            <TextBlock Style="{StaticResource Intro}" Text="When you double-click a file, which program should open it? These are the kinds of craft file found in your folder." />
                            <TextBlock Style="{StaticResource Help}" Margin="0,0,0,16" Text="“Windows’ choice” means the program your computer already uses for that kind of file. That’s usually right, so only change one if you’d like a different program." />
                            <Border Background="{DynamicResource B.subtle}" CornerRadius="12" Padding="14,12" Visibility="{Binding HasCraftTypes, Converter={StaticResource Vis}, ConverterParameter=not}">
                                <TextBlock FontSize="15" TextWrapping="Wrap" Text="No craft files were found in your folder yet, so there’s nothing to choose here. You can do this later in Settings (on the toolbar), under “Files &amp; safety”." />
                            </Border>
                            <ItemsControl ItemsSource="{Binding OpenWithRows}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
                                            <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected, Mode=OneWay}" Tag="{Binding Ext}" SelectionChanged="OnProgramChosen"
                                                      MinHeight="40" FontSize="15" AutomationProperties.Name="{Binding Label}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- 7. Files you'd rather not see -->
                        <StackPanel Visibility="{Binding Is7, Converter={StaticResource Vis}}">
                            <TextBlock Text="Files you’d rather not see" Style="{StaticResource Title}" />
                            <TextBlock Style="{StaticResource Intro}" Text="Folders often have other things in them, like spreadsheets or programs. Tick any kinds of file you’d rather not see in Craft Library." />
                            <TextBlock Style="{StaticResource Help}" Margin="0,0,0,16" Text="Hidden files stay safely in their folders: they’re just out of sight. You can show them again any time in Settings." />
                            <Border Background="{DynamicResource B.subtle}" CornerRadius="12" Padding="14,12" Visibility="{Binding HasHideRows, Converter={StaticResource Vis}, ConverterParameter=not}">
                                <TextBlock FontSize="15" TextWrapping="Wrap" Text="No files were found in your folder yet, so there’s nothing to hide. You can do this later in Settings (on the toolbar), under “Files &amp; safety”." />
                            </Border>
                            <ItemsControl ItemsSource="{Binding HideRows}" ItemTemplate="{StaticResource CheckRow}" Focusable="False" />
                        </StackPanel>

                        <!-- 8. Comfort and safety -->
                        <StackPanel Visibility="{Binding Is8, Converter={StaticResource Vis}}">
                            <TextBlock Text="Comfort and safety" Style="{StaticResource Title}" />
                            <TextBlock Style="{StaticResource Intro}" Text="These are all optional. Turn on any that sound helpful." />
                            <ItemsControl ItemsSource="{Binding ComfortChecks}" ItemTemplate="{StaticResource CheckRow}" Focusable="False" />
                        </StackPanel>

                        <!-- 9. All done -->
                        <StackPanel Visibility="{Binding Is9, Converter={StaticResource Vis}}">
                            <TextBlock Text="You’re ready to go!" Style="{StaticResource Title}" FontSize="30" />
                            <TextBlock Style="{StaticResource Intro}" Text="Here’s what you chose. Click “Change” to go back to any of them." />
                            <ItemsControl ItemsSource="{Binding Summary}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource B.line}" BorderThickness="0,0,0,1" Padding="0,10">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Content="Change" Command="{Binding Change}" FontSize="15" VerticalAlignment="Center" />
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" Width="190" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Value}" FontSize="15" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource Help}" Margin="0,18,0,0" Text="Tip: everything here is also in Settings (on the toolbar), any time you’d like to change it." />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </c:ShadowBorder>
    </Grid>
</UserControl>
