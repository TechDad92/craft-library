<UserControl x:Class="CraftLibrary.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CraftLibrary.App.Controls"
             TextElement.FontFamily="{DynamicResource F.popups}" x:Name="Me">
    <UserControl.Resources>
        <!-- A set of choices (Light / Dark…) -->
        <DataTemplate x:Key="Seg">
            <Button Style="{StaticResource Btn.Seg}" c:Ui.Active="{Binding On}" Command="{Binding Pick}" Content="{Binding Label}" />
        </DataTemplate>
        <ItemsPanelTemplate x:Key="Wrap">
            <WrapPanel />
        </ItemsPanelTemplate>
        <Style x:Key="SegList" TargetType="ItemsControl">
            <Setter Property="ItemTemplate" Value="{StaticResource Seg}" />
            <Setter Property="ItemsPanel" Value="{StaticResource Wrap}" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <DataTemplate x:Key="Swatch">
            <Button Style="{StaticResource Btn.Swatch}" Background="{Binding Hex, Converter={StaticResource Hex}}" c:Ui.Active="{Binding On}" Command="{Binding Pick}"
                    ToolTip="{Binding Label}" ToolTipService.IsEnabled="True" AutomationProperties.Name="{Binding Label}" />
        </DataTemplate>
        <DataTemplate x:Key="CheckRow">
            <CheckBox Style="{StaticResource Check}" IsChecked="{Binding On, Mode=OneWay}" Command="{Binding Toggle}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Help}" Style="{StaticResource Muted}" Visibility="{Binding Help, Converter={StaticResource Vis}}" />
                </StackPanel>
            </CheckBox>
        </DataTemplate>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,8" />
        </Style>

        <!-- One kind of file and the program it opens with -->
        <DataTemplate x:Key="OpenWithRow">
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="{Binding Label}" FontSize="13" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected, Mode=OneWay}" Tag="{Binding Ext}" SelectionChanged="OnProgramChosen"
                          MinHeight="38" FontSize="14" AutomationProperties.Name="{Binding Label}" />
            </StackPanel>
        </DataTemplate>

        <!-- The clickable heading of each section -->
        <DataTemplate x:Key="SectionHead">
            <Button Style="{StaticResource Btn.Ghost}" Command="{Binding Toggle}" HorizontalContentAlignment="Stretch" Padding="14,10" c:Ui.Radius="14" FontWeight="Normal">
                <DockPanel>
                    <c:Icon DockPanel.Dock="Right" Size="18" Margin="10,0,0,0">
                        <c:Icon.Style>
                            <Style TargetType="c:Icon">
                                <Setter Property="Glyph" Value="{StaticResource Icon.ChevronDown}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Open}" Value="True">
                                        <Setter Property="LayoutTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="180" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </c:Icon.Style>
                    </c:Icon>
                    <Border DockPanel.Dock="Right" Background="{DynamicResource B.accent-soft}" CornerRadius="999" Padding="8,1" VerticalAlignment="Center" Visibility="{Binding Changed, Converter={StaticResource Vis}}">
                        <TextBlock Text="Changed" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource B.accent-strong}" />
                    </Border>
                    <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="10" Background="{DynamicResource B.accent-soft}" Margin="0,0,12,0">
                        <c:Icon Glyph="{Binding Glyph}" Size="18" Foreground="{DynamicResource B.accent-strong}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="{Binding Summary}" FontSize="13" Foreground="{DynamicResource B.muted}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Button>
        </DataTemplate>

        <Style x:Key="SectionCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </UserControl.Resources>

    <c:ShadowBorder Background="{DynamicResource B.panel}" BorderBrush="{DynamicResource B.border}" BorderThickness="1,0,0,0">
        <DockPanel>
            <!-- Heading -->
            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource B.border}" BorderThickness="0,0,0,1" Padding="22,14,12,14">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Command="{Binding Close}" AutomationProperties.Name="Close settings">
                        <c:Icon Glyph="{StaticResource Icon.Close}" Size="20" />
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Content="Reset all" Command="{Binding ResetAll}" Margin="0,0,8,0" />
                    <TextBlock Text="Settings" FontSize="21" FontWeight="Bold" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel Margin="18,14,18,32">
                    <TextBlock Text="Changes show straight away and are saved for next time. Open a section to see its settings." Style="{StaticResource Muted}" FontSize="14" />
                    <Button Style="{StaticResource Btn.Plain}" Command="{Binding RunGuide}" HorizontalAlignment="Left" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <c:Icon Glyph="{StaticResource Icon.Sliders}" Size="18" Margin="0,0,8,0" />
                            <TextBlock Text="Run the setup guide again" />
                        </StackPanel>
                    </Button>
                    <DockPanel Margin="0,14,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Content="Collapse all" Command="{Binding CollapseAll}" FontSize="13" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Content="Expand all" Command="{Binding ExpandAll}" FontSize="13" Margin="8,0,0,0" />
                        <Grid>
                            <TextBox Style="{StaticResource Field}" Padding="36,8,12,8" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="Find a setting, e.g. font" AutomationProperties.Name="Find a setting" />
                            <c:Icon Glyph="{StaticResource Icon.Search}" Size="16" Foreground="{DynamicResource B.muted}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>
                    </DockPanel>
                    <TextBlock Text="No settings match that. Try another word, like colour, font or sort." Style="{StaticResource Muted}" FontSize="14" Margin="0,16,0,0" Visibility="{Binding NoResults, Converter={StaticResource Vis}}" />

                    <TextBlock Text="HOW IT LOOKS" Style="{StaticResource SectionLabel}" Margin="2,20,0,8" />

                    <!-- Colours -->
                    <Border Style="{StaticResource SectionCard}" DataContext="{Binding Colours}" Visibility="{Binding Visible, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SectionHead}" />
                            <StackPanel Margin="16,0,16,16" Visibility="{Binding Open, Converter={StaticResource Vis}}">
                                <StackPanel DataContext="{Binding DataContext, ElementName=Me}">
                                    <TextBlock Text="Theme" Style="{StaticResource Label}" Margin="0,4,0,8" />
                                    <ItemsControl Style="{StaticResource SegList}" ItemsSource="{Binding Theme}" />
                                    <TextBlock Text="Accent colour" Style="{StaticResource Label}" />
                                    <ItemsControl Style="{StaticResource SegList}" ItemsSource="{Binding Strength}" />
                                    <ItemsControl ItemsSource="{Binding Accents}" ItemTemplate="{StaticResource Swatch}" ItemsPanel="{StaticResource Wrap}" Focusable="False" Margin="0,4,0,0" />
                                    <TextBlock Text="Background colour" Style="{StaticResource Label}" />
                                    <ItemsControl ItemsSource="{Binding Tints}" ItemTemplate="{StaticResource Swatch}" ItemsPanel="{StaticResource Wrap}" Focusable="False" />
                                </StackPanel>
                                <Button Style="{StaticResource Btn.Link}" Content="Reset this section" Command="{Binding Reset}" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="{Binding Changed, Converter={StaticResource Vis}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Background -->
                    <Border Style="{StaticResource SectionCard}" DataContext="{Binding Style}" Visibility="{Binding Visible, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SectionHead}" />
                            <StackPanel Margin="16,0,16,16" Visibility="{Binding Open, Converter={StaticResource Vis}}">
                                <StackPanel DataContext="{Binding DataContext, ElementName=Me}">
                                    <TextBlock Text="Background" Style="{StaticResource Label}" Margin="0,4,0,8" />
                                    <ItemsControl Style="{StaticResource SegList}" ItemsSource="{Binding Textures}" />
                                </StackPanel>
                                <Button Style="{StaticResource Btn.Link}" Content="Reset this section" Command="{Binding Reset}" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="{Binding Changed, Converter={StaticResource Vis}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Text & fonts -->
                    <Border Style="{StaticResource SectionCard}" DataContext="{Binding Text}" Visibility="{Binding Visible, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SectionHead}" />
                            <StackPanel Margin="16,0,16,16" Visibility="{Binding Open, Converter={StaticResource Vis}}">
                                <StackPanel DataContext="{Binding DataContext, ElementName=Me}">
                                    <TextBlock Text="Fonts" Style="{StaticResource Label}" Margin="0,4,0,4" />
                                    <TextBlock Text="Pick a font for each part of the app. Every font installed on this computer is included, plus any you install from your library." Style="{StaticResource Muted}" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding FontRows}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource Btn.Row}" Command="{Binding Open}" FontSize="14" Padding="8,4">
                                                    <DockPanel>
                                                        <c:Icon DockPanel.Dock="Right" Glyph="{StaticResource Icon.ChevronRight}" Size="16" Margin="8,0,0,0" />
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Bold}" Value="True">
                                                                                <Setter Property="FontWeight" Value="Bold" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding FontLabel}" FontFamily="{Binding Family}" FontSize="15" FontWeight="Normal" Foreground="{DynamicResource B.muted}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Text size" Style="{StaticResource Label}" />
                                    <ItemsControl Style="{StaticResource SegList}" ItemsSource="{Binding TextSize}" />
                                    <TextBlock Text="Line spacing" Style="{StaticResource Label}" />
                                    <ItemsControl Style="{StaticResource SegList}" ItemsSource="{Binding LineSpacing}" />
                                    <TextBlock Text="Easy-reading fonts (Atkinson Hyperlegible, Lexend and OpenDyslexic) are in the font picker." Style="{StaticResource Muted}" Margin="0,8,0,0" />
                                </StackPanel>
                                <Button Style="{StaticResource Btn.Link}" Content="Reset this section" Command="{Binding Reset}" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="{Binding Changed, Converter={StaticResource Vis}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Layout -->
                    <Border Style="{StaticResource SectionCard}" DataContext="{Binding Layout}" Visibility="{Binding Visible, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SectionHead}" />
                            <StackPanel Margin="16,0,16,16" Visibility="{Binding Open, Converter={StaticResource Vis}}">
                                <StackPanel DataContext="{Binding DataContext, ElementName=Me}">
                                    <TextBlock Text="Show files as" Style="{StaticResource Label}" Margin="0,4,0,8" />
                                    <ItemsControl Style="{StaticResource SegList}" ItemsSource="{Binding View}" />
                                    <TextBlock Text="Thumbnail size" Style="{StaticResource Label}" />
                                    <ItemsControl Style="{StaticResource SegList}" ItemsSource="{Binding Thumb}" />
                                    <TextBlock Text="Preview panel" Style="{StaticResource Label}" />
                                    <ItemsControl Style="{StaticResource SegList}" ItemsSource="{Binding Preview}" />
                                    <TextBlock Text="Folder list" Style="{StaticResource Label}" />
                                    <ItemsControl Style="{StaticResource SegList}" ItemsSource="{Binding Sidebar}" />
                                    <TextBlock Text="Spacing" Style="{StaticResource Label}" />
                                    <ItemsControl Style="{StaticResource SegList}" ItemsSource="{Binding Density}" />
                                    <TextBlock Text="Show with each file" Style="{StaticResource Label}" />
                                    <ItemsControl ItemsSource="{Binding ShowWith}" ItemTemplate="{StaticResource CheckRow}" Focusable="False" />
                                    <TextBlock Text="Order files by" Style="{StaticResource Label}" />
                                    <ItemsControl Style="{StaticResource SegList}" ItemsSource="{Binding Order}" />
                                    <TextBlock Text="Main buttons show" Style="{StaticResource Label}" />
                                    <ItemsControl Style="{StaticResource SegList}" ItemsSource="{Binding BtnLabels}" />
                                </StackPanel>
                                <Button Style="{StaticResource Btn.Link}" Content="Reset this section" Command="{Binding Reset}" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="{Binding Changed, Converter={StaticResource Vis}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="HOW IT WORKS" Style="{StaticResource SectionLabel}" Margin="2,20,0,8" />

                    <!-- Comfort & focus -->
                    <Border Style="{StaticResource SectionCard}" DataContext="{Binding Comfort}" Visibility="{Binding Visible, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SectionHead}" />
                            <StackPanel Margin="16,0,16,16" Visibility="{Binding Open, Converter={StaticResource Vis}}">
                                <TextBlock Text="These all start switched off, so try them one at a time." Style="{StaticResource Muted}" Margin="0,4,0,12" />
                                <ItemsControl DataContext="{Binding DataContext, ElementName=Me}" ItemsSource="{Binding ComfortChecks}" ItemTemplate="{StaticResource CheckRow}" Focusable="False" />
                                <Button Style="{StaticResource Btn.Link}" Content="Reset this section" Command="{Binding Reset}" HorizontalAlignment="Left" Margin="0,4,0,0" Visibility="{Binding Changed, Converter={StaticResource Vis}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Files & safety -->
                    <Border Style="{StaticResource SectionCard}" DataContext="{Binding Files}" Visibility="{Binding Visible, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SectionHead}" />
                            <StackPanel Margin="16,0,16,16" Visibility="{Binding Open, Converter={StaticResource Vis}}">
                                <StackPanel DataContext="{Binding DataContext, ElementName=Me}">
                                    <ItemsControl ItemsSource="{Binding SafetyChecks}" ItemTemplate="{StaticResource CheckRow}" Focusable="False" Margin="0,4,0,0" />
                                    <TextBlock Text="Open files with" Style="{StaticResource Label}" />
                                    <TextBlock Text="“Windows default” uses the program Windows normally opens that kind of file with. Only change one if you want this app to use a different program." Style="{StaticResource Muted}" Margin="0,0,0,10" />
                                    <!-- Craft files (pictures, PDFs, cut files, Word, zips, fonts) -->
                                    <ItemsControl ItemsSource="{Binding CraftOpenWithRows}" ItemTemplate="{StaticResource OpenWithRow}" Focusable="False" />
                                    <!-- Every other kind of file, out of the way until asked for -->
                                    <Button Style="{StaticResource Btn.Plain}" Command="{Binding ToggleOtherTypes}" HorizontalAlignment="Left" Margin="0,4,0,10"
                                            Visibility="{Binding HasOtherTypes, Converter={StaticResource Vis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding OtherTypesButton}" />
                                            <c:Icon Size="16" Margin="8,0,0,0">
                                                <c:Icon.Style>
                                                    <Style TargetType="c:Icon">
                                                        <Setter Property="Glyph" Value="{StaticResource Icon.ChevronDown}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowOtherTypes}" Value="True">
                                                                <Setter Property="LayoutTransform">
                                                                    <Setter.Value>
                                                                        <RotateTransform Angle="180" />
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </c:Icon.Style>
                                            </c:Icon>
                                        </StackPanel>
                                    </Button>
                                    <Border BorderBrush="{DynamicResource B.border}" BorderThickness="2,0,0,0" Padding="12,0,0,0" Margin="0,0,0,6"
                                            Visibility="{Binding ShowOtherTypes, Converter={StaticResource Vis}}">
                                        <StackPanel>
                                            <TextBlock Text="Other kinds of files found in your folders." Style="{StaticResource Muted}" Margin="0,0,0,8" />
                                            <ItemsControl ItemsSource="{Binding OtherOpenWithRows}" ItemTemplate="{StaticResource OpenWithRow}" Focusable="False" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Hide kinds of files" Style="{StaticResource Label}" />
                                    <TextBlock Text="Tick any kinds of file you’d rather not see. They stay safely in their folders, just out of sight. Untick to see them again." Style="{StaticResource Muted}" Margin="0,0,0,8" />
                                    <Border Background="{DynamicResource B.info-bg}" CornerRadius="10" Padding="12,8" Margin="0,0,0,10" Visibility="{Binding HiddenNote, Converter={StaticResource Vis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <c:Icon Glyph="{StaticResource Icon.EyeOff}" Size="16" Foreground="{DynamicResource B.info-ink}" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding HiddenNote}" FontSize="13" Foreground="{DynamicResource B.info-ink}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding HideRows}" ItemTemplate="{StaticResource CheckRow}" Focusable="False" />
                                </StackPanel>
                                <Button Style="{StaticResource Btn.Link}" Content="Reset this section" Command="{Binding Reset}" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="{Binding Changed, Converter={StaticResource Vis}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Buttons & features -->
                    <Border Style="{StaticResource SectionCard}" DataContext="{Binding Features}" Visibility="{Binding Visible, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SectionHead}" />
                            <StackPanel Margin="16,0,16,16" Visibility="{Binding Open, Converter={StaticResource Vis}}">
                                <TextBlock Text="Hide puts something out of the way. Bring it back any time from the “Hidden” button at the top. Off removes it until you switch it back on here." Style="{StaticResource Muted}" Margin="0,4,0,12" />
                                <ItemsControl DataContext="{Binding DataContext, ElementName=Me}" ItemsSource="{Binding FeatureRows}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,6">
                                                <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" />
                                                <ItemsControl Style="{StaticResource SegList}" ItemsSource="{Binding Options}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Style="{StaticResource Btn.Link}" Content="Reset this section" Command="{Binding Reset}" HorizontalAlignment="Left" Margin="0,4,0,0" Visibility="{Binding Changed, Converter={StaticResource Vis}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </c:ShadowBorder>
</UserControl>
