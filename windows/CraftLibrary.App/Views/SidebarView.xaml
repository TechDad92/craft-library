<UserControl x:Class="CraftLibrary.App.Views.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CraftLibrary.App.Controls"
             xmlns:vm="clr-namespace:CraftLibrary.App.ViewModels"
             Width="290" TextElement.FontFamily="{DynamicResource F.folders}">
    <Border Background="{DynamicResource B.bg}" BorderBrush="{DynamicResource B.divider}" x:Name="Frame">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderThickness" Value="0,0,3,0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding SidebarRight}" Value="True">
                        <Setter Property="BorderThickness" Value="3,0,0,0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="12,20,12,24">

                <!-- First visit: choose the craft folder -->
                <Border Visibility="{Binding IsSetup, Converter={StaticResource Vis}}" Background="{DynamicResource B.chrome}" BorderBrush="{DynamicResource B.border}" BorderThickness="1" CornerRadius="14" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Where are your craft files?" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Text="Pick the main folder that holds all your craft folders. You can add portable drives later." FontSize="14" Foreground="{DynamicResource B.chrome-muted}" TextWrapping="Wrap" Margin="0,10,0,12" />
                        <Button Style="{StaticResource Btn.Primary}" Command="{Binding ChooseCraftFolder}">
                            <StackPanel Orientation="Horizontal">
                                <c:Icon Glyph="{StaticResource Icon.Folder}" Size="18" Margin="0,0,8,0" />
                                <TextBlock Text="Choose craft folder" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <StackPanel Visibility="{Binding IsSetup, Converter={StaticResource Vis}, ConverterParameter=not}">
                    <!-- Sorting -->
                    <TextBlock Text="SORTING" Style="{StaticResource SectionLabel}" Margin="12,0,12,8" Visibility="{Binding ShowSortingHead, Converter={StaticResource Vis}}" />
                    <StackPanel Visibility="{Binding FeatInbox, Converter={StaticResource Vis}}">
                        <Button Style="{StaticResource Btn.Row}" c:Ui.Active="{Binding InboxActive}" Command="{Binding GoInbox}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding InboxCount}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource B.muted}" VerticalAlignment="Center" Margin="8,0,4,0" />
                                <c:Icon Glyph="{StaticResource Icon.Inbox}" Size="18" Margin="4,0,12,0" />
                                <TextBlock Text="To sort" VerticalAlignment="Center" />
                            </DockPanel>
                        </Button>
                        <DockPanel Margin="44,2,4,8">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Content="Change" Command="{Binding ChangeInbox}" FontSize="13" MinHeight="28" />
                            <TextBlock Text="{Binding InboxPathShort}" FontSize="12" Foreground="{DynamicResource B.muted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding InboxPathShort}" />
                        </DockPanel>
                    </StackPanel>
                    <Button Style="{StaticResource Btn.Row}" c:Ui.Active="{Binding LaterActive}" Command="{Binding GoLater}" Visibility="{Binding FeatLater, Converter={StaticResource Vis}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding LaterCount}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource B.muted}" VerticalAlignment="Center" Margin="8,0,4,0" />
                            <c:Icon Glyph="{StaticResource Icon.Clock}" Size="18" Margin="4,0,12,0" />
                            <TextBlock Text="Sort later" VerticalAlignment="Center" />
                        </DockPanel>
                    </Button>

                    <!-- Locations -->
                    <TextBlock Text="LOCATIONS" Style="{StaticResource SectionLabel}" Margin="12,24,12,8" />
                    <ItemsControl ItemsSource="{Binding SideRows}" Focusable="False">
                        <ItemsControl.Resources>
                            <DataTemplate DataType="{x:Type vm:SideHeaderRow}">
                                <Button Style="{StaticResource Btn.Row}" c:Ui.Active="{Binding Active}" Command="{Binding Pick}" Margin="0,8,0,2" Padding="8,4">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="32" Height="32" Command="{Binding Forget}" Foreground="{DynamicResource B.muted}"
                                                ToolTip="Take this location off the list (nothing is deleted)" ToolTipService.IsEnabled="True" AutomationProperties.Name="Take this location off the list">
                                            <c:Icon Glyph="{StaticResource Icon.Close}" Size="16" />
                                        </Button>
                                        <c:Icon Glyph="{StaticResource Icon.Drive}" Size="18" Margin="4,0,12,0" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Path}" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource B.muted}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:SideFolderRow}">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="36" Height="36" Command="{Binding ColourLabel}" Foreground="{DynamicResource B.muted}"
                                            Visibility="{Binding ShowColourButton, Converter={StaticResource Vis}}" ToolTip="Colour label" AutomationProperties.Name="Colour label">
                                        <c:Icon Glyph="{StaticResource Icon.Palette}" Size="18" />
                                    </Button>
                                    <Grid Margin="{Binding Indent}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource Btn.Icon}" Width="26" Height="36" Command="{Binding ToggleKids}" Visibility="{Binding HasKids, Converter={StaticResource Vis}}"
                                                ToolTip="{Binding KidsHint}" AutomationProperties.Name="{Binding KidsHint}" Foreground="{DynamicResource B.muted}">
                                            <c:Icon Size="16">
                                                <c:Icon.Style>
                                                    <Style TargetType="c:Icon">
                                                        <Setter Property="Glyph" Value="{StaticResource Icon.ChevronRight}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Open}" Value="True">
                                                                <Setter Property="Glyph" Value="{StaticResource Icon.ChevronDown}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </c:Icon.Style>
                                            </c:Icon>
                                        </Button>
                                        <Button Grid.Column="1" Style="{StaticResource Btn.Row}" c:Ui.Active="{Binding Active}" Command="{Binding Pick}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource B.muted}" VerticalAlignment="Center" Margin="8,0,4,0" />
                                                <c:Icon Glyph="{StaticResource Icon.Folder}" Size="18" Margin="0,0,10,0"
                                                        Fill="{Binding LabelColour, Converter={StaticResource Hex}}" Stroke="{Binding LabelLine, Converter={StaticResource Hex}}" />
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </Button>
                                    </Grid>
                                </DockPanel>
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:SideNoteRow}">
                                <TextBlock Text="{Binding Text}" Style="{StaticResource Muted}" Margin="44,4,8,8" />
                            </DataTemplate>
                        </ItemsControl.Resources>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding OfflineNotes}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource B.info-bg}" CornerRadius="10" Padding="12,8" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding}" FontSize="13" Foreground="{DynamicResource B.info-ink}" TextWrapping="Wrap" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Style="{StaticResource Btn.Plain}" Background="Transparent" BorderBrush="{DynamicResource B.dash}" Foreground="{DynamicResource B.accent-text}"
                            Margin="0,12,0,0" Padding="12,6" HorizontalContentAlignment="Left" Command="{Binding AddLocation}" Visibility="{Binding FeatAddLoc, Converter={StaticResource Vis}}">
                        <DockPanel>
                            <c:Icon Glyph="{StaticResource Icon.Plus}" Size="18" Margin="0,0,10,0" />
                            <TextBlock Text="Add location (e.g. portable drive)" TextWrapping="Wrap" />
                        </DockPanel>
                    </Button>

                    <Rectangle Height="1" Fill="{DynamicResource B.border}" Margin="0,16" />
                    <Button Style="{StaticResource Btn.Row}" c:Ui.Active="{Binding BinActive}" Command="{Binding GoBin}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding BinCount}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource B.muted}" VerticalAlignment="Center" Margin="8,0,4,0"
                                       Visibility="{Binding FeatRecycleCount, Converter={StaticResource Vis}}" />
                            <c:Icon Glyph="{StaticResource Icon.Trash}" Size="18" Margin="4,0,12,0" />
                            <TextBlock Text="Recycle Bin" VerticalAlignment="Center" />
                        </DockPanel>
                    </Button>

                    <TextBlock Text="{Binding ScanNote}" Style="{StaticResource Muted}" Margin="12,16,12,0" Visibility="{Binding ScanNote, Converter={StaticResource Vis}}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
